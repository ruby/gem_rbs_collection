module Datadog
  def self.configuration: () -> Core::Configuration::Settings

  def self.configure: () { (Core::Configuration::Settings) -> void } -> Core::Configuration::Settings

  def self.configure_onto: (Object target, **untyped options) -> untyped

  def self.configuration_for: (Object target, ?Symbol? option) -> untyped

  def self.logger: () -> ::Logger

  def self.shutdown!: () -> void
end
