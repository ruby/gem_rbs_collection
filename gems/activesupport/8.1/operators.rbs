# active_support/duration.rb
module ActiveSupport
  # K records which parts a Duration can hold: :calendar for days, weeks,
  # months and years, :clock for seconds, minutes and hours, a union of
  # both when mixed, and top when unknown. Date#+ uses it to tell a Date
  # result from a Time one.
  class Duration[out K = top]
    class Scalar
      def coerce: (untyped other) -> [Scalar, self]
                | ...

      def +: (Duration other) -> Duration
           | (Numeric other) -> Scalar
           | ...

      def -: (Duration other) -> Duration
           | (Numeric other) -> Scalar
           | ...

      def *: (Duration other) -> Duration
           | (Numeric other) -> Scalar
           | ...

      def /: (Duration other) -> Numeric
           | (Numeric other) -> Scalar
           | ...

      def %: (Duration other) -> Duration
           | (Numeric other) -> Scalar
           | ...
    end

    def self.new: (Numeric value, Hash[Symbol, Numeric] parts, ?bool? variable) -> Duration

    def coerce: (untyped other) -> [Scalar, self]
              | ...

    # A Numeric operand is added as seconds.
    def +: [K2] (Duration[K2] other) -> Duration[K | K2]
         | (Numeric other) -> Duration[K | :clock]
         | ...

    def -: [K2] (Duration[K2] other) -> Duration[K | K2]
         | (Numeric other) -> Duration[K | :clock]
         | ...

    def *: (Duration | Numeric other) -> Duration[K]
         | ...

    def /: (Duration other) -> Numeric
         | (Numeric other) -> Duration[K]
         | ...

    def %: (Duration | Numeric other) -> Duration
         | ...
  end
end

# active_support/core_ext/string/output_safety.rb
module ActiveSupport
  class SafeBuffer
    def []: (*untyped args) -> String?

    def +: (untyped other) -> self

    def *: (untyped _) -> SafeBuffer

    def %: (untyped args) -> self
  end
end

# active_support/hash_with_indifferent_access.rb
module ActiveSupport
  class HashWithIndifferentAccess[T, U]
    def self.[]: (*untyped args) -> instance

    # Assigns a new value to the hash:
    #
    #   hash = ActiveSupport::HashWithIndifferentAccess.new
    #   hash[:key] = 'value'
    #
    # This value can be later fetched using either +:key+ or <tt>'key'</tt>.
    #
    # If the value is a Hash or contains one or multiple Hashes, they will be
    # converted to +HashWithIndifferentAccess+.
    def []=: (untyped key, U value) -> U

    # Same as <tt>Hash#[]</tt> where the key passed as argument can be
    # either a string or a symbol:
    #
    #   counters = ActiveSupport::HashWithIndifferentAccess.new
    #   counters[:foo] = 1
    #
    #   counters['foo'] # => 1
    #   counters[:foo]  # => 1
    #   counters[:zoo]  # => nil
    %a{implicitly-returns-nil} def []: (untyped key) -> U
  end
end
