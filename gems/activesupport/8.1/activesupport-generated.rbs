  #
  #   C.new(0, 1).instance_values # => {"x" => 0, "y" => 1}
  def instance_values: () -> untyped

  # Returns an array of instance variable names as strings including "@".
  #
  #   class C
  #     def initialize(x, y)
  #       @x, @y = x, y
  #     end
  #   end
  #
  #   C.new(0, 1).instance_variable_names # => ["@x", "@y"]
  def instance_variable_names: () -> untyped
end

