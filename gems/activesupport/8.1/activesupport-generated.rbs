      METHOD_CACHES: untyped

      def initialize: (untyped namespace) -> void

      def define_cached_method: (untyped canonical_name, ?as: untyped?) { (untyped) -> untyped } -> untyped

      def apply: (untyped owner, untyped path, untyped line) -> untyped
    end

    def self.batch: (untyped owner, untyped path, untyped line) { (untyped) -> untyped } -> untyped

    def initialize: (untyped owner, untyped path, untyped line) -> void

    def class_eval: () { (untyped) -> untyped } -> untyped

