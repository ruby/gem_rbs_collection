      class Unused < ::ActionDispatch::Routing::ConsoleFormatter::Sheet
        def header: (untyped routes) -> untyped

        def no_routes: (untyped engine, untyped routes, untyped filter) -> untyped
      end
    end

    class HtmlTableFormatter
      def initialize: (untyped view) -> void

      def section_title: (untyped title) -> untyped

      def section: (untyped routes) -> untyped

      # The header is part of the HTML page, so we don't construct it here.
