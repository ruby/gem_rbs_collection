      include ::Singleton

      KEY: :action_dispatch_server_timing_events

      def initialize: () -> void

      def call: (untyped event) -> (untyped | nil)

      def collect_events: () { () -> untyped } -> untyped

      def ensure_subscribed: () -> untyped

      def unsubscribe: () -> untyped
    end

    def self.unsubscribe: () -> untyped

    def initialize: (untyped app) -> void

    def call: (untyped env) -> untyped
  end
end

module ActionDispatch
  module Session
    class SessionRestoreError < ::StandardError
      def initialize: () -> void
    end

    module Compatibility
      def initialize: (untyped app, ?::Hash[untyped, untyped] options) -> void

      def generate_sid: () -> untyped

      private

      def initialize_sid: () -> untyped

      def make_request: (untyped env) -> ActionDispatch::Request
    end

    module StaleSessionCheck
      def load_session: (untyped env) -> untyped

      def extract_session_id: (untyped env) -> untyped

      def stale_session_check!: () { () -> untyped } -> untyped
    end

    module SessionObject
      def commit_session: (untyped req, untyped res) -> untyped

      def prepare_session: (untyped req) -> untyped

      def loaded_session?: (untyped session) -> untyped
    end

    class AbstractStore < ::Rack::Session::Abstract::Persisted
