      def user_agent_version_reported?: () -> untyped

      def unsupported_browser?: () -> untyped

      def version_guarded_browser?: () -> untyped

      def bot?: () -> untyped

      def version_below_minimum_required?: () -> (untyped | true)

      def minimum_browser_version_for_browser: () -> untyped

      def expanded_versions: () -> untyped

      def normalized_browser_name: () -> untyped
    end
