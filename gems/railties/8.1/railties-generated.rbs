module Rails
  module Initializable
    def self.included: (untyped base) -> untyped

    class Initializer
      attr_reader name: untyped

      attr_reader block: untyped

      attr_reader before: untyped

      attr_reader after: untyped

      def initialize: (untyped name, untyped context, before: untyped, after: untyped, ?group: untyped?) { (?) -> untyped } -> void

      def belongs_to?: (untyped group) -> untyped

      def run: (*untyped args) -> untyped

      def bind: (untyped context) -> (self | untyped)

      def context_class: () -> untyped
    end

    class Collection
      include ::Enumerable[untyped]

      include ::TSort[untyped]

      def initialize: (?untyped? initializers) -> void

      def to_a: () -> untyped

      def last: () -> untyped

      def each: () ?{ (?) -> untyped } -> untyped

      alias tsort_each_node each

      def tsort_each_child: (untyped initializer) { (?) -> untyped } -> untyped

      def +: (untyped other) -> untyped

      def <<: (untyped initializer) -> self

      def push: (*untyped initializers) -> self

      alias append push

      def concat: (*untyped initializer_collections) -> self

      def has?: (untyped name) -> untyped
    end

    def run_initializers: (?::Symbol group, *untyped args) -> (nil | untyped)

    def initializers: () -> untyped

    module ClassMethods
      def initializers: () -> untyped

      def initializers_chain: () -> untyped

      def initializers_for: (untyped binding) -> untyped

      def initializer: (untyped name, ?::Hash[untyped, untyped] opts) ?{ (?) -> untyped } -> untyped
    end
  end
end

