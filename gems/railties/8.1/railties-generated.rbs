        def base_package: () -> "sqlite3"

        def build_package: () -> nil

        def feature_name: () -> "ghcr.io/rails/devcontainer/features/sqlite3"
      end

      class MariaDBMySQL2 < ::Rails::Generators::Database::MySQL2
