    attr_accessor sandbox: untyped

    alias sandbox? sandbox

    attr_reader reloaders: untyped

    attr_reader reloader: untyped

    attr_reader executor: untyped

    attr_reader autoloaders: untyped

    INITIAL_VARIABLES: ::Array[:config | :railties | :routes_reloader | :reloaders | :routes | :helpers | :app_env_config]

    def initialize: (?::Hash[untyped, untyped] initial_variable_values) ?{ (?) -> untyped } -> void

    # Returns the dasherized application name.
    #
    #   MyApp::Application.new.name => "my-app"
    def name: () -> untyped

    def run_load_hooks!: () -> self

    # Reload application routes regardless if they changed or not.
    def reload_routes!: () -> untyped

    def reload_routes_unless_loaded: () -> untyped

    # Convenience for loading config/foo.yml for the current \Rails env.
    # Example:
    #
    #     # config/exception_notification.yml:
    #     production:
    #       url: http://127.0.0.1:8080
    #       namespace: my_app_production
    #
    #     development:
    #       url: http://localhost:3001
    #       namespace: my_app_development
    #
    # <code></code>
    #
    #     # config/environments/production.rb
    #     Rails.application.configure do
    #       config.middleware.use ExceptionNotifier, config_for(:exception_notification)
    #     end
    #
    # You can also store configurations in a shared section which will be merged
    # with the environment configuration
    #
    #     # config/example.yml
    #     shared:
    #       foo:
    #         bar:
    #           baz: 1
    #
    #     development:
    #       foo:
    #         bar:
    #           qux: 2
    #
    # <code></code>
    #
    #     # development environment
    #     Rails.application.config_for(:example)[:foo][:bar]
    #     # => { baz: 1, qux: 2 }
