module Rails
  module Configuration
    class MiddlewareStackProxy
      def delete: (*untyped, **untyped) ?{ (?) -> untyped } -> void

      def insert_before: (*untyped, **untyped) ?{ (?) -> untyped } -> void

      alias insert insert_before

      def insert_after: (*untyped, **untyped) ?{ (?) -> untyped } -> void

      def swap: (*untyped, **untyped) ?{ (?) -> untyped } -> void

      def unshift: (*untyped, **untyped) ?{ (?) -> untyped } -> void

      def use: (*untyped, **untyped) ?{ (?) -> untyped } -> void

      def move_before: (*untyped, **untyped) ?{ (?) -> untyped } -> void

      alias move move_before

      def move_after: (*untyped, **untyped) ?{ (?) -> untyped } -> void
    end
  end
end

module Rails
  class Engine
    class Configuration
      # Holds the built ActionDispatch::MiddlewareStack once Engine#app is called,
      # but typed as the proxy used while configuring the application
      def middleware: () -> Rails::Configuration::MiddlewareStackProxy

      def middleware=: (Rails::Configuration::MiddlewareStackProxy | ActionDispatch::MiddlewareStack) -> void
    end

    # Defines the routes for this engine. If a block is given to
    # routes, it is appended to the engine.
    def routes: () ?{ () [self: ActionDispatch::Routing::Mapper] -> void } -> ActionDispatch::Routing::RouteSet
  end
end

module Rails
  module Generators
    class PluginGenerator < AppBase
      # It is necessary to satisfy alias target.
      def app_path: () -> untyped
    end
  end
end

module Rails
  class Application
    def config: () -> ::Rails::Application::Configuration
  end

  def self.application: () -> Rails::Application

  class Railtie
    class Configuration
      def app_middleware: () -> Rails::Configuration::MiddlewareStackProxy
    end

    def configure: () { (Rails::Application) [self: Rails::Application] -> void } -> void
    def self.config: () -> ::Rails::Application::Configuration
  end

  class Railties
    extend Initializable::ClassMethods
  end
end
