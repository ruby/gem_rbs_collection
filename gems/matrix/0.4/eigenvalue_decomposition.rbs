class Matrix[T]
  # Complex matrices are not supported as input.
  # The results hold Float or Complex elements.
  class EigenvalueDecomposition
    def initialize: (Matrix[untyped] a) -> void

    def eigenvector_matrix: () -> Matrix[untyped]
    alias v eigenvector_matrix

    def eigenvector_matrix_inv: () -> Matrix[untyped]
    alias v_inv eigenvector_matrix_inv

    def eigenvalues: () -> Array[Float | Complex]

    def eigenvectors: () -> Array[Vector[untyped]]

    def eigenvalue_matrix: () -> Matrix[untyped]
    alias d eigenvalue_matrix

    def to_ary: () -> [Matrix[untyped], Matrix[untyped], Matrix[untyped]]
    alias to_a to_ary
  end
end
