module Marcel
  class Magic
    attr_reader type: String
    attr_reader mediatype: String
    attr_reader subtype: String

    def self.by_extension: (_ToS ext) -> instance?
    def self.by_path: (String | Pathname path) -> instance?
    def self.by_magic: (IO | StringIO | Tempfile io) -> instance?
    def self.all_by_magic: (IO | StringIO | Tempfile io) -> Array[instance]
  end

  class MimeType
    def self.for: (?Pathname | IO | StringIO pathname_or_io, ?name: String, ?extension: String, ?declared_type: String) -> String
  end
end
