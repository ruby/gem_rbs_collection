class PasswordStrategy < Warden::Strategies::Base
  def authenticate!: () -> untyped
end

class InspectingStrategy < Warden::Strategies::Base
  def authenticate!: () -> untyped

  private

  def performed_check: () -> bool
end

class Account
  def id: () -> Integer
end

class HelloApp
  def call: (Rack::env) -> Rack::response
end
