module Stripe
  class AccountService < StripeService
    attr_reader capabilities: ::Stripe::AccountCapabilityService

    attr_reader external_accounts: ::Stripe::AccountExternalAccountService

    attr_reader login_links: ::Stripe::AccountLoginLinkService

    attr_reader persons: ::Stripe::AccountPersonService

    def create: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Account

    def delete: (String account, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Account

    def list: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::ListObject[::Stripe::Account]

    def reject: (String account, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Account

    def retrieve: (String account, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Account

    def retrieve_current: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Account

    def unreject: (String account, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Account

    def update: (String account, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Account
  end
end
