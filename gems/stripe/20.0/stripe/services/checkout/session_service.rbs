module Stripe
  module Checkout
    class SessionService < StripeService
      attr_reader line_items: ::Stripe::Checkout::SessionLineItemService

      def create: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Checkout::Session

      def expire: (String session, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Checkout::Session

      def list: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::ListObject[::Stripe::Checkout::Session]

      def retrieve: (String session, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Checkout::Session

      def update: (String session, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Checkout::Session
    end
  end
end
