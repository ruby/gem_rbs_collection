module Stripe
  class PlanService < StripeService
    def create: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Plan

    def delete: (String plan, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Plan

    def list: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::ListObject[::Stripe::Plan]

    def retrieve: (String plan, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Plan

    def update: (String plan, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Plan
  end
end
