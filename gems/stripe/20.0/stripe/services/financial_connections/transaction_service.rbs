module Stripe
  module FinancialConnections
    class TransactionService < StripeService
      def list: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::ListObject[::Stripe::FinancialConnections::Transaction]

      def retrieve: (String transaction, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::FinancialConnections::Transaction
    end
  end
end
