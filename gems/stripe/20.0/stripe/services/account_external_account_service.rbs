module Stripe
  class AccountExternalAccountService < StripeService
    def create: (String account, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> (::Stripe::BankAccount | ::Stripe::Card)

    def delete: (String account, String id, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> (::Stripe::BankAccount | ::Stripe::Card)

    def list: (String account, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::ListObject[::Stripe::BankAccount | ::Stripe::Card]

    def retrieve: (String account, String id, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> (::Stripe::BankAccount | ::Stripe::Card)

    def update: (String account, String id, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> (::Stripe::BankAccount | ::Stripe::Card)
  end
end
