module Stripe
  module V2
    class BillingService < StripeService
      attr_reader meter_events: ::Stripe::V2::Billing::MeterEventService

      attr_reader meter_event_adjustments: ::Stripe::V2::Billing::MeterEventAdjustmentService

      attr_reader meter_event_session: ::Stripe::V2::Billing::MeterEventSessionService

      attr_reader meter_event_stream: ::Stripe::V2::Billing::MeterEventStreamService
    end
  end
end
