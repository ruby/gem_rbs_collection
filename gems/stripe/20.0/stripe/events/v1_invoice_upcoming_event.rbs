module Stripe
  module Events
    class V1InvoiceUpcomingEvent < Stripe::V2::Core::Event
      def self.lookup_type: () -> "v1.invoice.upcoming"
    end

    class V1InvoiceUpcomingEventNotification < Stripe::V2::Core::EventNotification
      def self.lookup_type: () -> "v1.invoice.upcoming"
    end
  end
end
