module Stripe
  module Events
    class V1BalanceAvailableEvent < Stripe::V2::Core::Event
      def self.lookup_type: () -> "v1.balance.available"

      def fetch_related_object: () -> untyped

      attr_reader related_object: untyped
    end

    class V1BalanceAvailableEventNotification < Stripe::V2::Core::EventNotification
      def self.lookup_type: () -> "v1.balance.available"

      attr_reader related_object: ::Stripe::V2::Core::RelatedSingletonObject

      def fetch_related_object: () -> untyped
    end
  end
end
