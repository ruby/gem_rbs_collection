module Stripe
  module Events
    class V1InvoiceUpdatedEvent < Stripe::V2::Core::Event
      def self.lookup_type: () -> "v1.invoice.updated"

      def fetch_related_object: () -> untyped

      attr_reader related_object: untyped
    end

    class V1InvoiceUpdatedEventNotification < Stripe::V2::Core::EventNotification
      def self.lookup_type: () -> "v1.invoice.updated"

      attr_reader related_object: ::Stripe::V2::Core::RelatedObject

      def fetch_related_object: () -> untyped
    end
  end
end
