module Stripe
  module Entitlements
    class Feature < APIResource
      def active: () -> bool

      def id: () -> String

      def livemode: () -> bool

      def lookup_key: () -> String

      def metadata: () -> ::Stripe::StripeObject

      def name: () -> String

      def object: () -> String

      def self.create: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Entitlements::Feature

      def self.list: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::ListObject[::Stripe::Entitlements::Feature]

      def self.update: (String id, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Entitlements::Feature
    end
  end
end
