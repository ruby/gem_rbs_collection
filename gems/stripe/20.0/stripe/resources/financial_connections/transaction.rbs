module Stripe
  module FinancialConnections
    class Transaction < APIResource
      class StatusTransitions < ::Stripe::StripeObject
        def posted_at: () -> Integer?

        def void_at: () -> Integer?
      end

      def account: () -> String

      def amount: () -> Integer

      def currency: () -> String

      def description: () -> String

      def id: () -> String

      def livemode: () -> bool

      def object: () -> String

      def status: () -> String

      def status_transitions: () -> StatusTransitions

      def transacted_at: () -> Integer

      def transaction_refresh: () -> String

      def updated: () -> Integer

      def self.list: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::ListObject[::Stripe::FinancialConnections::Transaction]
    end
  end
end
