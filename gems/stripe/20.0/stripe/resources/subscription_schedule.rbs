      def description: () -> String?

      def invoice_settings: () -> InvoiceSettings

      def on_behalf_of: () -> (String | ::Stripe::Account)?

      def transfer_data: () -> TransferData?
    end

    class PauseSchedule < ::Stripe::StripeObject
