          def invoicing_behavior: () -> String

          def type: () -> String
        end

        class Status < ::Stripe::StripeObject
          class Error < ::Stripe::StripeObject
            def code: () -> String?

            def message: () -> String
          end

          def error: () -> Error?

          def type: () -> String
        end

        def pause_at: () -> Integer

        def settings: () -> Settings?

        def status: () -> Status
      end

      class Resume < ::Stripe::StripeObject
        class Settings < ::Stripe::StripeObject
          def billing_cycle_anchor: () -> String

          def payment_behavior: () -> String

          def proration_behavior: () -> String
        end

        class Status < ::Stripe::StripeObject
          class Error < ::Stripe::StripeObject
            def code: () -> String?

            def message: () -> String
          end

          def error: () -> Error?

          def type: () -> String
        end

        def resume_at: () -> Integer

        def settings: () -> Settings

        def status: () -> Status
      end

      def key: () -> String

      def pause: () -> Pause

      def resume: () -> Resume?
    end

