          class Start < ::Stripe::StripeObject
            def timestamp: () -> Integer?

            def type: () -> String
          end

          def end: () -> End

          def start: () -> Start
        end

        def discountable: () -> bool?

        def discounts: () -> ::Array[Discount]

        def metadata: () -> ::Stripe::StripeObject?

        def period: () -> Period

        def price: () -> (String | ::Stripe::Price)

        def quantity: () -> Integer?

        def tax_rates: () -> ::Array[::Stripe::TaxRate]?
