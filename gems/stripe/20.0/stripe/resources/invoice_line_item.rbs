module Stripe
  class InvoiceLineItem < APIResource
    class DiscountAmount < ::Stripe::StripeObject
      def amount: () -> Integer

      def discount: () -> (String | ::Stripe::Discount)
    end

    class Parent < ::Stripe::StripeObject
      class InvoiceItemDetails < ::Stripe::StripeObject
        class ProrationDetails < ::Stripe::StripeObject
          class CreditedItems < ::Stripe::StripeObject
            def invoice: () -> String

            def invoice_line_items: () -> ::Array[String]
          end

          def credited_items: () -> CreditedItems?
        end

        def invoice_item: () -> String

        def proration: () -> bool

        def proration_details: () -> ProrationDetails?

        def subscription: () -> String?
      end

      class SubscriptionItemDetails < ::Stripe::StripeObject
        class ProrationDetails < ::Stripe::StripeObject
          class CreditedItems < ::Stripe::StripeObject
            def invoice: () -> String

            def invoice_line_items: () -> ::Array[String]
          end

          def credited_items: () -> CreditedItems?
        end

        def invoice_item: () -> String?

        def proration: () -> bool

        def proration_details: () -> ProrationDetails?

        def subscription: () -> String?

        def subscription_item: () -> String
      end

      def invoice_item_details: () -> InvoiceItemDetails?

      def subscription_item_details: () -> SubscriptionItemDetails?

      def type: () -> String
    end

    class Period < ::Stripe::StripeObject
      def end: () -> Integer

      def start: () -> Integer
    end

    class PretaxCreditAmount < ::Stripe::StripeObject
      def amount: () -> Integer

      def credit_balance_transaction: () -> (String | ::Stripe::Billing::CreditBalanceTransaction)?

      def discount: () -> (String | ::Stripe::Discount)?

      def type: () -> String
    end

    class Pricing < ::Stripe::StripeObject
      class PriceDetails < ::Stripe::StripeObject
        def price: () -> (String | ::Stripe::Price)

        def product: () -> String
      end

      def price_details: () -> PriceDetails?

      def type: () -> String

      def unit_amount_decimal: () -> BigDecimal?
    end

    class Tax < ::Stripe::StripeObject
      class TaxRateDetails < ::Stripe::StripeObject
        def tax_rate: () -> String
      end

      def amount: () -> Integer

      def tax_behavior: () -> String

      def tax_rate_details: () -> TaxRateDetails?

      def taxability_reason: () -> String

      def taxable_amount: () -> Integer?

      def type: () -> String
    end

    def amount: () -> Integer

    def currency: () -> String

    def description: () -> String?

    def discount_amounts: () -> ::Array[DiscountAmount]?

    def discountable: () -> bool

    def discounts: () -> ::Array[String | ::Stripe::Discount]

    def id: () -> String

    def invoice: () -> String?

    def livemode: () -> bool

    def metadata: () -> ::Stripe::StripeObject

    def object: () -> String

    def parent: () -> Parent?

    def period: () -> Period

    def pretax_credit_amounts: () -> ::Array[PretaxCreditAmount]?

    def pricing: () -> Pricing?

    def quantity: () -> Integer?

    def quantity_decimal: () -> BigDecimal?

    def subscription: () -> (String | ::Stripe::Subscription)?

    def subtotal: () -> Integer

    def taxes: () -> ::Array[Tax]?

    def self.update: (String invoice, String line_item_id, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::InvoiceLineItem
  end
end
