    class SourceOrder < ::Stripe::StripeObject
      class Item < ::Stripe::StripeObject
        def amount: () -> Integer?

        def currency: () -> String?

        def description: () -> String?

        def parent: () -> String?

        def quantity: () -> Integer?

        def type: () -> String?
