    def self.create: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Source

    def self.update: (String source, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Source

    def verify: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Source

