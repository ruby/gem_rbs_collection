module Stripe
  module Terminal
    class Location < APIResource
      class Address < ::Stripe::StripeObject
        def city: () -> String?

        def country: () -> String?

        def line1: () -> String?

        def line2: () -> String?

        def postal_code: () -> String?

        def state: () -> String?
      end

      class AddressKana < ::Stripe::StripeObject
        def city: () -> String?

        def country: () -> String?

        def line1: () -> String?

        def line2: () -> String?

        def postal_code: () -> String?

        def state: () -> String?

        def town: () -> String?
      end

      class AddressKanji < ::Stripe::StripeObject
        def city: () -> String?

        def country: () -> String?

        def line1: () -> String?

        def line2: () -> String?

        def postal_code: () -> String?

        def state: () -> String?

        def town: () -> String?
      end

      def address: () -> Address

      def address_kana: () -> AddressKana?

      def address_kanji: () -> AddressKanji?

      def configuration_overrides: () -> String?

      def deleted: () -> bool?

      def display_name: () -> String

      def display_name_kana: () -> String?

      def display_name_kanji: () -> String?

      def id: () -> String

      def livemode: () -> bool

      def metadata: () -> ::Stripe::StripeObject

      def object: () -> String

      def phone: () -> String?

      def self.create: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Terminal::Location

      def self.delete: (String location, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Terminal::Location

      def delete: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Terminal::Location

      def self.list: (?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::ListObject[::Stripe::Terminal::Location]

      def self.update: (String location, ?::Hash[untyped, untyped] params, ?::Stripe::request_opts opts) -> ::Stripe::Terminal::Location
    end
  end
end
