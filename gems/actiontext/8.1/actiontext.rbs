module ActionText
  module Attribute
    module ClassMethods
      def has_rich_text: (String | Symbol name, ?encrypted: bool, ?strict_loading: bool, ?store_if_blank: bool) -> void
      def with_all_rich_text: () -> untyped
      def rich_text_association_names: () -> Array[String]
    end
  end
end

module ActiveRecord
  class Base
    include ActionText::Attribute
    extend ActionText::Attribute::ClassMethods
  end
end

module ActionText
  class RichText
    # Columns and associations, which rbs prototype doesn't see
    attr_accessor name: String

    attr_accessor body: ActionText::Content?

    def record: () -> untyped

    def embeds: () -> ActiveStorage::Attached::Many

    def created_at: () -> ActiveSupport::TimeWithZone

    def updated_at: () -> ActiveSupport::TimeWithZone
  end
end

# Return types of commonly used methods
module ActionText
  class RichText
    def to_s: () -> String

    def to_plain_text: () -> String

    def to_trix_html: () -> String?
  end

  class Content
    def links: () -> Array[String]

    def attachments: () -> Array[ActionText::Attachment]

    def gallery_attachments: () -> Array[ActionText::Attachment]

    def to_plain_text: () -> String

    def to_trix_html: () -> String

    def to_html: () -> String

    def to_s: () -> String
  end
end
