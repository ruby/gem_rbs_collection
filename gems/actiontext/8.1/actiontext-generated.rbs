    ATTRIBUTES: untyped

    ATTRIBUTE_TYPES: { "previewable" => untyped, "filesize" => untyped, "width" => untyped, "height" => untyped, default: untyped }

    def self.from_attributes: (untyped attributes) -> untyped

    def self.process_attributes: (untyped attributes) -> untyped

    def self.transform_attribute_keys: (untyped attributes) -> untyped

    def self.typecast_attribute_values: (untyped attributes) -> untyped

    attr_reader node: untyped

    def initialize: (untyped node) -> void

    def attributes: () -> untyped

    def to_html: () -> untyped

    def to_s: () -> untyped

    private

    def attachment_attributes: () -> untyped

    def composed_attributes: () -> untyped

    def read_json_object_attribute: (untyped name) -> untyped

    def read_json_attribute: (untyped name) -> (untyped | nil)
  end
end

