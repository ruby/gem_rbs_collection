module Rinku
  VERSION: String

  AUTOLINK_SHORT_DOMAINS: Integer

  type mode = :all | :urls | :email_addresses

  def self.skip_tags: () -> Array[String]?

  def self.skip_tags=: (Array[String]? tags) -> Array[String]?

  def self.auto_link: (String text, ?mode? mode, ?String? link_attr, ?Array[String]? skip_tags, ?Integer flags) ?{ (String url) -> String } -> String
end
