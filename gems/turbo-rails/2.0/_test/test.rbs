class Message < ActiveRecord::Base
  def board: () -> String
  def target_name: () -> String
  def quietly_count: () -> Integer
  def suppressed?: () -> bool
  def announce: () -> void
  def announce_later: () -> void
  def render_later: () -> void
end

class MessagesController < ActionController::Base
  def create: () -> void
  def update: () -> void
  def native?: () -> bool
end
