module Doorkeeper
  def self.configure: () { () [self: Config::Builder] -> void } -> Config

  def self.configuration: () -> Config

  def self.config: () -> Config

  def self.configured?: () -> bool

  class Config
    class AbstractBuilder
    end

    class Builder < AbstractBuilder
      def orm: (Symbol orm) -> void

      def resource_owner_authenticator: () { (Doorkeeper::ApplicationController controller) [self: Doorkeeper::ApplicationController] -> untyped } -> void

      def admin_authenticator: () { (Doorkeeper::ApplicationsController controller) [self: Doorkeeper::ApplicationsController] -> untyped } -> void

      def resource_owner_from_credentials: () { (Doorkeeper::TokensController controller) [self: Doorkeeper::TokensController] -> untyped } -> void

      def base_controller: (String controller) -> void
                         | () { () -> String } -> void

      def application_class: (String class_name) -> void

      def access_token_class: (String class_name) -> void

      def access_grant_class: (String class_name) -> void

      def enable_application_owner: (?confirmation: bool) -> void

      def default_scopes: (*Symbol | String scopes) -> void

      def optional_scopes: (*Symbol | String scopes) -> void

      def scopes_by_grant_type: (?Hash[Symbol, Array[Symbol | String]] scopes) -> void

      def enforce_configured_scopes: () -> void

      def access_token_expires_in: ((Integer | ::ActiveSupport::Duration)? duration) -> void

      def authorization_code_expires_in: ((Integer | ::ActiveSupport::Duration)? duration) -> void

      def custom_access_token_expires_in: () { (untyped context) -> (Integer | ::ActiveSupport::Duration)? } -> void

      def use_refresh_token: (?bool enabled) -> void
                           | () { (untyped context) -> boolish } -> void

      def reuse_access_token: () -> void

      def token_reuse_limit: (Integer percentage) -> void

      def grant_flows: (Array[String] flows) -> void

      def pkce_code_challenge_methods: (Array[String] methods) -> void

      def force_pkce: () -> void

      def access_token_methods: (*Symbol | Proc methods) -> void

      def client_credentials: (*Symbol methods) -> void

      def api_only: () -> void

      def enforce_content_type: () -> void

      def handle_auth_errors: (:render | :raise | :redirect mode) -> void

      def realm: (String realm) -> void

      def hash_token_secrets: (?using: String?, ?fallback: (String | Symbol)?) -> void

      def hash_application_secrets: (?using: String?, ?fallback: (String | Symbol)?) -> void

      def force_ssl_in_redirect_uri: (bool enabled) -> void
                                   | () { (::URI::Generic uri) -> boolish } -> void

      def forbid_redirect_uri: () { (::URI::Generic uri) -> boolish } -> void

      def custom_access_token_attributes: (Array[Symbol] attributes) -> void

      def skip_authorization: () { (untyped resource_owner, OAuth::Client client) [self: Doorkeeper::AuthorizationsController] -> boolish } -> void

      def allow_grant_flow_for_client: () { (String grant_flow, untyped client) -> boolish } -> void

      def authorize_resource_owner_for_client: () { (untyped client, untyped resource_owner) -> boolish } -> void

      def before_successful_authorization: () { (::ActionController::Metal controller, ?OAuth::Hooks::Context? context) -> void } -> void

      def after_successful_authorization: () { (::ActionController::Metal controller, ?OAuth::Hooks::Context? context) -> void } -> void

      def before_successful_strategy_response: () { (untyped request) -> void } -> void

      def after_successful_strategy_response: () { (untyped request, untyped response) -> void } -> void

      def custom_introspection_response: () { (Doorkeeper::AccessToken token, ::ActionController::Metal context) -> Hash[untyped, untyped]? } -> void
    end

    def access_token_expires_in: () -> (Integer | ::ActiveSupport::Duration)?

    def authorization_code_expires_in: () -> (Integer | ::ActiveSupport::Duration)?

    def orm: () -> Symbol

    def default_scopes: () -> OAuth::Scopes

    def optional_scopes: () -> OAuth::Scopes

    def scopes: () -> OAuth::Scopes

    def grant_flows: () -> Array[String]

    def pkce_code_challenge_methods: () -> Array[String]

    def access_token_methods: () -> Array[Symbol | Proc]

    def custom_access_token_attributes: () -> Array[Symbol]

    def native_redirect_uri: () -> String

    def refresh_token_enabled?: () -> (bool | Proc)

    def enable_application_owner?: () -> bool

    def enforce_configured_scopes?: () -> bool

    def force_pkce?: () -> bool

    def api_only: () -> bool

    def enforce_content_type: () -> bool

    def access_token_model: () -> singleton(Doorkeeper::AccessToken)

    def access_grant_model: () -> singleton(Doorkeeper::AccessGrant)

    def application_model: () -> singleton(Doorkeeper::Application)
  end

  module Errors
    class DoorkeeperError < StandardError
    end

    class BaseResponseError < DoorkeeperError
      attr_reader response: OAuth::ErrorResponse

      def self.name_for_response: () -> Symbol
    end

    class InvalidRequest < BaseResponseError
    end

    class InvalidToken < BaseResponseError
    end

    class InvalidClient < BaseResponseError
    end

    class InvalidScope < BaseResponseError
    end

    class InvalidRedirectUri < BaseResponseError
    end

    class InvalidGrant < BaseResponseError
    end

    class UnauthorizedClient < BaseResponseError
    end

    class UnsupportedResponseType < BaseResponseError
    end

    class AccessDenied < BaseResponseError
    end

    class ServerError < BaseResponseError
    end

    class TokenExpired < InvalidToken
    end

    class TokenRevoked < InvalidToken
    end

    class TokenUnknown < InvalidToken
    end

    class TokenForbidden < InvalidToken
    end
  end

  module Grape
    class AuthorizationDecorator < ::SimpleDelegator
      def initialize: (untyped request) -> void

      def parameters: () -> untyped

      def authorization: () -> String?
    end
  end

  module Rails
    module Helpers
      def doorkeeper_authorize!: (*Symbol | String scopes) -> void

      def doorkeeper_unauthorized_render_options: (?error: OAuth::ErrorResponse?) -> Hash[Symbol, untyped]?

      def doorkeeper_forbidden_render_options: (?error: OAuth::ErrorResponse?) -> Hash[Symbol, untyped]?

      def valid_doorkeeper_token?: () -> bool?

      private

      def doorkeeper_render_error: () -> void

      def doorkeeper_invalid_token_response?: () -> bool

      def doorkeeper_token: () -> Doorkeeper::AccessToken?
    end

    class Routes
      class Mapper
        def controllers: (Hash[Symbol, String] controller_names) -> void

        def skip_controllers: (*Symbol controller_names) -> void

        def as: (Hash[Symbol, untyped] alias_names) -> void
      end

      module Helper
        def use_doorkeeper: (?{ ?scope: String } options) ?{ (Mapper mapper) [self: Mapper] -> void } -> void
      end
    end
  end
end

class ActionController::Base
  include Doorkeeper::Rails::Helpers
end

class ActionController::API
  include Doorkeeper::Rails::Helpers
end

class ActionDispatch::Routing::Mapper
  include Doorkeeper::Rails::Routes::Helper
end
