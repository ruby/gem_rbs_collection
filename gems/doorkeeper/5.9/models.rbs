    def revoked_at: () -> ActiveSupport::TimeWithZone?

    def revoked_at=: (Time? value) -> Time?

    def created_at: () -> ActiveSupport::TimeWithZone

    def scopes: () -> OAuth::Scopes

    def scopes=: (String | Array[Symbol | String] | OAuth::Scopes value) -> void

    def scopes_string: () -> String?

    def includes_scope?: (*Symbol | String required_scopes) -> bool

    def use_refresh_token=: (bool value) -> bool

    def accessible?: () -> bool

    def acceptable?: (Array[Symbol | String] | OAuth::Scopes scopes) -> bool

    def expired?: () -> bool

    def revoked?: () -> bool

    def revoke: (?untyped clock) -> void

    def expires_at: () -> Time?

    def expires_in_seconds: () -> Integer?

    def token_type: () -> String

    def plaintext_token: () -> String?

    def plaintext_refresh_token: () -> String?
  end

