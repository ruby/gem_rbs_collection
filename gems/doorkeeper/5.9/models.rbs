    def self.by_refresh_token: (String? refresh_token) -> AccessToken?

    def self.by_previous_refresh_token: (String? previous_refresh_token) -> AccessToken?

    def self.by_resource_owner: (untyped resource_owner) -> ActiveRecord_Relation

    def self.active_for: (untyped resource_owner) -> ActiveRecord_Relation

    def self.not_expired: () -> ActiveRecord_Relation

    def self.ordered_by: (Symbol | String attribute, ?(:asc | :desc) direction) -> ActiveRecord_Relation

