module Doorkeeper
  class Application < ::ActiveRecord::Base
    extend ::_ActiveRecord_Relation_ClassMethods[Application, ActiveRecord_Relation, Integer]

    class ActiveRecord_Relation < ::ActiveRecord::Relation
      include ::_ActiveRecord_Relation[Application, Integer]
      include Enumerable[Application]

      def ordered_by: (Symbol | String attribute, ?(:asc | :desc) direction) -> ActiveRecord_Relation
    end

    class ActiveRecord_Associations_CollectionProxy < ::ActiveRecord::Associations::CollectionProxy
      include ::_ActiveRecord_Relation[Application, Integer]
      include Enumerable[Application]
    end

    def self.by_uid: (String uid) -> Application?

    def self.by_uid_and_secret: (String uid, String? secret) -> Application?

    def self.authorized_for: (untyped resource_owner) -> ActiveRecord_Relation

    def self.revoke_tokens_and_grants_for: (Integer id, untyped resource_owner) -> void

    def self.ordered_by: (Symbol | String attribute, ?(:asc | :desc) direction) -> ActiveRecord_Relation

    def id: () -> Integer

    def name: () -> String

    def name=: (String value) -> String

    def uid: () -> String

    def uid=: (String value) -> String

    def secret: () -> String?

    def secret=: (String? value) -> String?

    def redirect_uri: () -> String

    def redirect_uri=: (String | Array[String] uris) -> (String | Array[String])

    def scopes: () -> OAuth::Scopes

    def scopes=: (String | Array[Symbol | String] | OAuth::Scopes value) -> void

    def scopes_string: () -> String?

    def includes_scope?: (*Symbol | String required_scopes) -> bool

    def confidential: () -> bool

    def confidential=: (bool value) -> bool

    def confidential?: () -> bool

    def owner: () -> untyped

    def owner=: (untyped owner) -> untyped

    def owner_id: () -> Integer?

    def owner_id=: (Integer? value) -> Integer?

    def owner_type: () -> String?

    def owner_type=: (String? value) -> String?

    def created_at: () -> ActiveSupport::TimeWithZone

    def updated_at: () -> ActiveSupport::TimeWithZone

    def access_grants: () -> AccessGrant::ActiveRecord_Associations_CollectionProxy

    def access_tokens: () -> AccessToken::ActiveRecord_Associations_CollectionProxy

    def authorized_tokens: () -> AccessToken::ActiveRecord_Associations_CollectionProxy

    def renew_secret: () -> void

    def plaintext_secret: () -> String?

    def secret_matches?: (String? input) -> bool

    def authorized_for_resource_owner?: (untyped resource_owner) -> boolish
  end

