    def self.find_or_create_for: (application: Application, resource_owner: untyped, scopes: OAuth::Scopes | String, **untyped token_attributes) -> AccessToken

    def self.create_for: (application: Application, resource_owner: untyped, scopes: OAuth::Scopes | String, **untyped token_attributes) -> AccessToken

    def self.authorized_tokens_for: (Integer application_id, untyped resource_owner) -> ActiveRecord_Relation

    def self.last_authorized_token_for: (Integer application_id, untyped resource_owner) -> AccessToken?

    def self.refresh_token_revoked_on_use?: () -> bool

    def id: () -> Integer

    def token: () -> String

    def token=: (String value) -> String

    def refresh_token: () -> String?

    def refresh_token=: (String? value) -> String?

    def previous_refresh_token: () -> String?

    def resource_owner_id: () -> Integer?

    def resource_owner_id=: (Integer? value) -> Integer?

    def application_id: () -> Integer?

