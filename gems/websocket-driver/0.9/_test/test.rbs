class TestClientSocket
  @url: String

  def initialize: (String url) -> void

  def url: () -> String

  def write: (String data) -> Integer
end

class TestRackSocket < TestClientSocket
  @env: Hash[String, untyped]

  def initialize: (Hash[String, untyped] env) -> void

  def env: () -> Hash[String, untyped]
end
