    ON_WHITE_STYLE: HighLine::Style
    ON_YELLOW: ::String
    ON_YELLOW_STYLE: HighLine::Style
    RED: ::String
    RED_STYLE: HighLine::Style
    RESET: ::String
    RESET_STYLE: HighLine::Style
    REVERSE: ::String
    REVERSE_STYLE: HighLine::Style
    UNDERLINE: ::String
    UNDERLINE_STYLE: HighLine::Style
    UNDERSCORE: ::String
    UNDERSCORE_STYLE: HighLine::Style
