    module ClassMethods
      RGB_COLOR_PATTERN: Regexp

      # Resolves RGB constants such as RGB_FF6000 (a code String) and
      # ON_RGB_FF6000_STYLE (a Style). Raises NameError for other names.
      def const_missing: (Symbol name) -> (::String | HighLine::Style)
    end
  end

  module CustomErrors
    class ExplainableError < StandardError
      def explanation_key: () -> Symbol?
    end

    class QuestionError < ExplainableError
      def explanation_key: () -> nil
    end

    class NotValidQuestionError < ExplainableError
      def explanation_key: () -> Symbol
    end

    class NotInRangeQuestionError < ExplainableError
      def explanation_key: () -> Symbol
    end

    class NoConfirmationQuestionError < ExplainableError
      def explanation_key: () -> nil
    end

    class NoAutoCompleteMatch < ExplainableError
      def explanation_key: () -> Symbol
    end
  end

  class Style
    def self.index: (Style style) -> Style

    def self.clear_index: () -> void

    # An Array argument is turned into its to_s (Style.new(rgb: [...])
    # passes one).
    def self.rgb_hex: (*(Numeric | ::String | Array[Integer]) colors) -> ::String

    def self.rgb_parts: (::String hex) -> Array[Integer]

    def self.rgb: (*(Numeric | ::String) colors) -> Style

    def self.rgb_number: (*(Numeric | Array[Numeric]) parts) -> Integer

    # Raises RuntimeError outside 16..231.
    def self.ansi_rgb_to_hex: (Integer ansi_number) -> ::String

    def self.list: () -> Hash[untyped, Style]

    def self.code_index: () -> Hash[::String, Array[Style]]

    def self.uncolor: (::String string) -> ::String

    attr_reader name: (Symbol | ::String | Array[HighLine::style])?

    attr_reader list: Array[HighLine::style]?

    attr_accessor rgb: Array[Integer]?

    attr_accessor builtin: bool?

    def initialize: (?Hash[Symbol, untyped] defn) -> void

    def dup: () -> Style

    def to_hash: () -> Hash[Symbol, untyped]

    def color: (::String string) -> ::String

    def code: () -> ::String

    def red: () -> Integer?

    def green: () -> Integer?

    def blue: () -> Integer?

    # Raises RuntimeError for a Style list.
    def variant: (untyped new_name, ?Hash[Symbol, untyped] options) -> Style

    def on: () -> Style

    # Raises for a Style list.
    def bright: () -> Style

    # Raises for a Style list.
    def light: () -> Style
  end

  class ColorScheme
    def initialize: (?Hash[untyped, Array[HighLine::style]]? h) ?{ (ColorScheme scheme) -> void } -> void

    def load_from_hash: (Hash[untyped, Array[HighLine::style]] h) -> void

    def include?: (_ToS color_tag) -> bool

    def []: (_ToS color_tag) -> Style?

    def definition: (_ToS color_tag) -> Array[HighLine::style]?

    # Keys are downcased Strings.
    def keys: () -> Array[::String]

    def []=: (_ToS color_tag, Array[HighLine::style] constants) -> void

    def to_hash: () -> Hash[::String, Array[HighLine::style]]
  end

  class SampleColorScheme < ColorScheme
    SAMPLE_SCHEME: Hash[Symbol, Array[Symbol]]

    # super(SAMPLE_SCHEME) passes the block on to ColorScheme#initialize.
    def initialize: (?untyped _h) ?{ (ColorScheme scheme) -> void } -> void
  end

  class Question
    include CustomErrors

    # A custom validator for Question#validate.
    interface _Validator
      def valid?: (untyped answer) -> boolish
    end

    def self.build: (::String | Question template_or_question, ?untyped answer_type) ?{ (Question question) -> void } -> Question

    def initialize: (_ToS template, untyped answer_type) ?{ (Question question) -> void } -> void

    attr_accessor template: ::String

    attr_accessor answer: untyped

    attr_accessor answer_type: untyped

    attr_accessor completion: untyped

    attr_accessor character: (bool | :getc)?

    attr_accessor limit: Integer?

    # true echoes the input, false or nil echoes nothing, a String is echoed
    # for each character.
    attr_accessor echo: (bool | ::String)?

    attr_accessor readline: bool?

    # :strip (the default), :chomp, :collapse, :strip_and_collapse,
    # :chomp_and_collapse, :remove, or nil/false for none.
    attr_accessor whitespace: (Symbol | false)?

    # :up, :upcase, :down, :downcase, :capitalize or nil.
    attr_accessor case: Symbol?

    attr_accessor default: untyped

    attr_accessor default_hint_show: bool

    attr_accessor validate: (Regexp | ^(untyped answer) -> boolish | _Validator)?

    attr_accessor above: untyped

    attr_accessor below: untyped

    # Any object responding to include?.
    attr_accessor in: untyped

    attr_accessor confirm: (bool | ::String | ^(untyped answer) -> ::String)?

    attr_accessor gather: (Integer | ::String | Symbol | Regexp | Hash[untyped, untyped] | false)?

    attr_accessor verify_match: bool?

    attr_writer first_answer: ::String?

    attr_accessor directory: Pathname | ::String

    attr_accessor glob: ::String

    # The messages shown to the user, by key (:ask_on_error, :not_valid,
    # :not_in_range, :invalid_type, :no_completion, :ambiguous_completion,
    # :mismatch). A value may be a String, :question (for :ask_on_error),
    # or a callable given the answer.
    def responses: () -> Hash[Symbol, untyped]

    attr_accessor overwrite: bool

    def to_s: () -> ::String
  end

  class Menu < Question
    attr_accessor self.index_color: untyped

    def initialize: () ?{ (Menu menu) -> void } -> void

    attr_reader index: Symbol | ::String

    attr_accessor index_suffix: ::String

    # :index, :name or :index_or_name.
    attr_accessor select_by: Symbol

    attr_accessor flow: Symbol

    attr_accessor list_option: (Integer | ::String)?

    attr_accessor header: ::String?

    attr_accessor prompt: ::String

    attr_reader layout: Symbol | ::String

    attr_accessor shell: bool

    attr_accessor nil_on_handled: bool

    # false, or the colors to give HighLine.color.
    attr_accessor index_color: untyped

    # The action gets the item name, and in shell mode the rest of the line.
    def choice: (untyped name, ?::String? help, ?untyped text) ?{ (untyped name, ?::String details) -> untyped } -> void

    def build_item: (untyped name, Hash[Symbol, untyped] attributes) -> Menu::Item

    def add_item: (Menu::Item item) -> void

    def choices: (*untyped names) ?{ (untyped name, ?::String details) -> untyped } -> void

    def hidden: (untyped name, ?::String? help) ?{ (untyped name, ?::String details) -> untyped } -> void

    # :number, :letter, :capital_letter, :none or a literal String.
    def index=: (Symbol | ::String style) -> void

    def init_help: () -> void

    def help: (::String topic, ::String help) -> void

    # :list, :one_line, :menu_only or an ERB String.
    def layout=: (:list | :one_line | :menu_only | ::String new_layout) -> void

    def options: () -> Array[untyped]

    def select: (HighLine highline_context, untyped selection, ?untyped details) -> untyped

    def to_ary: () -> Array[::String]

    def to_s: () -> ::String

    def update_responses: () -> Hash[Symbol, untyped]

    class Item
      attr_reader name: untyped

      attr_reader text: untyped

      attr_reader help: ::String?

      attr_reader action: Proc?

      def initialize: (untyped name, Hash[Symbol, untyped] attributes) -> void

      def item_help: () -> Hash[::String, ::String]
    end
  end

  class String < ::String
    include StringExtensions

    def color: (*HighLine::style args) -> self

    alias foreground color

    def on: (_ToS arg) -> self

    def uncolor: () -> self

    # Raises RuntimeError unless the colors make a 6-digit hex code.
    def rgb: (*(Numeric | ::String) colors) -> self

    def on_rgb: (*(Numeric | ::String) colors) -> self

    def black: () -> self
    def red: () -> self
    def green: () -> self
    def yellow: () -> self
    def blue: () -> self
    def magenta: () -> self
    def cyan: () -> self
    def white: () -> self
    def gray: () -> self
    def grey: () -> self
    def none: () -> self
    def bright_black: () -> self
    def light_black: () -> self
    def bright_red: () -> self
    def light_red: () -> self
    def bright_green: () -> self
    def light_green: () -> self
    def bright_yellow: () -> self
    def light_yellow: () -> self
    def bright_blue: () -> self
    def light_blue: () -> self
    def bright_magenta: () -> self
    def light_magenta: () -> self
    def bright_cyan: () -> self
    def light_cyan: () -> self
    def bright_white: () -> self
    def light_white: () -> self
    def bright_gray: () -> self
    def light_gray: () -> self
    def bright_grey: () -> self
    def light_grey: () -> self
    def bright_none: () -> self
    def light_none: () -> self
    def on_black: () -> self
    def on_red: () -> self
    def on_green: () -> self
    def on_yellow: () -> self
    def on_blue: () -> self
    def on_magenta: () -> self
    def on_cyan: () -> self
    def on_white: () -> self
    def on_gray: () -> self
    def on_grey: () -> self
    def on_none: () -> self
    def on_bright_black: () -> self
    def on_light_black: () -> self
    def on_bright_red: () -> self
    def on_light_red: () -> self
    def on_bright_green: () -> self
    def on_light_green: () -> self
    def on_bright_yellow: () -> self
    def on_light_yellow: () -> self
    def on_bright_blue: () -> self
    def on_light_blue: () -> self
    def on_bright_magenta: () -> self
    def on_light_magenta: () -> self
    def on_bright_cyan: () -> self
    def on_light_cyan: () -> self
    def on_bright_white: () -> self
    def on_light_white: () -> self
    def on_bright_gray: () -> self
    def on_light_gray: () -> self
    def on_bright_grey: () -> self
    def on_light_grey: () -> self
    def on_bright_none: () -> self
    def on_light_none: () -> self

    # These replace ::String#clear and ::String#reverse with styling.
    def clear: () -> self
    def reset: () -> self
    def bold: () -> self
    def dark: () -> self
    def underline: () -> self
    def underscore: () -> self
    def blink: () -> self
    def reverse: () -> self
    def concealed: () -> self
  end

  module StringExtensions
    STYLE_METHOD_NAME_PATTERN: Regexp
  end

  class Terminal
    # Returns an IOConsole terminal unless io/console fails to load.
    def self.get_terminal: (HighLine::_Input? input, HighLine::_Output output) -> Terminal

    attr_reader input: HighLine::_Input?

    attr_reader output: HighLine::_Output

    def initialize: (HighLine::_Input? input, HighLine::_Output output) -> void

    # [columns, lines]
    def terminal_size: () -> Array[Integer]?

    def character_mode: () -> ::String

    class IOConsole < Terminal
      def terminal_size: () -> Array[Integer]?
    end
  end
end
