    DARK: ::String
    DARK_STYLE: HighLine::Style
    ERASE_CHAR: ::String
    ERASE_CHAR_STYLE: HighLine::Style
    ERASE_LINE: ::String
    ERASE_LINE_STYLE: HighLine::Style
    GRAY: ::String
    GRAY_STYLE: HighLine::Style
    GREEN: ::String
    GREEN_STYLE: HighLine::Style
    GREY: ::String
    GREY_STYLE: HighLine::Style
    LIGHT_BLACK: ::String
    LIGHT_BLACK_STYLE: HighLine::Style
    LIGHT_BLUE: ::String
    LIGHT_BLUE_STYLE: HighLine::Style
    LIGHT_CYAN: ::String
    LIGHT_CYAN_STYLE: HighLine::Style
    LIGHT_GRAY: ::String
    LIGHT_GRAY_STYLE: HighLine::Style
    LIGHT_GREEN: ::String
    LIGHT_GREEN_STYLE: HighLine::Style
    LIGHT_GREY: ::String
    LIGHT_GREY_STYLE: HighLine::Style
    LIGHT_MAGENTA: ::String
    LIGHT_MAGENTA_STYLE: HighLine::Style
    LIGHT_NONE: ::String
    LIGHT_NONE_STYLE: HighLine::Style
    LIGHT_RED: ::String
    LIGHT_RED_STYLE: HighLine::Style
    LIGHT_WHITE: ::String
    LIGHT_WHITE_STYLE: HighLine::Style
    LIGHT_YELLOW: ::String
    LIGHT_YELLOW_STYLE: HighLine::Style
    MAGENTA: ::String
    MAGENTA_STYLE: HighLine::Style
