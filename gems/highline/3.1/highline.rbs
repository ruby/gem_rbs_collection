class HighLine
  # The input stream methods HighLine reads with (IO, StringIO, ...).
  interface _Input
    def gets: () -> ::String?
    def eof?: () -> bool
  end

  # The output stream methods HighLine writes with (IO, StringIO, ...).
  interface _Output
    def puts: (*untyped) -> untyped
    def print: (*untyped) -> untyped
    def flush: () -> untyped
  end

  # What HighLine.Style and the color methods accept: a style name
  # (:red, :bold, :rgb_ff6000, a color scheme key), an escape code String,
  # a Style, a Style definition Hash, or a list of those.
  type style = Symbol | ::String | HighLine::Style | Hash[Symbol, untyped] | Array[style] | nil

  include BuiltinStyles
  include CustomErrors
  extend SingleForwardable
  extend BuiltinStyles::ClassMethods

  VERSION: ::String

  # nil only while highline.rb creates the first instance.
  def self.default_instance: () -> HighLine?

  def self.default_instance=: (HighLine default_instance) -> HighLine

  attr_accessor self.color_scheme: ColorScheme?

  def self.using_color_scheme?: () -> bool?

  # Raises RuntimeError when a key is already in the current scheme.
  def self.add_to_color_scheme: (Hash[untyped, Array[style]] hash) -> ColorScheme

  def self.reset_color_scheme: () -> nil

  def self.reset: () -> void

  def self.supports_rgb_color?: () -> bool

  def self.Style: (*style args) -> Style

  # Raises NameError when the argument names no style.
  def self.find_or_create_style: (style arg) -> Style

  def self.find_or_create_style_list: (*style args) -> Style

  def self.String: (::String s) -> HighLine::String

  # Adds the HighLine::String color methods to ::String.
  def self.colorize_strings: () -> void

  # Delegated to HighLine.default_instance.
  def self.agree: (::String yes_or_no_question, ?(bool | :getc)? character) ?{ (Question question) -> void } -> bool
  def self.ask: (::String | Question template_or_question, ?untyped answer_type) ?{ (Question question) -> void } -> untyped
  def self.choose: (*untyped items) ?{ (Menu menu) -> void } -> untyped
  def self.say: (_ToS? statement) -> void
  def self.use_color=: (bool setting) -> bool
  def self.use_color?: () -> bool
  def self.reset_use_color: () -> bool
  def self.track_eof=: (bool setting) -> bool
  def self.track_eof?: () -> bool?
  def self.color: (::String string, *style colors) -> ::String
  def self.uncolor: (::String string) -> ::String
  def self.color_code: (*style colors) -> ::String

  def initialize: (?_Input? input, ?_Output output, ?(Integer | :auto)? wrap_at, ?(Integer | :auto)? page_at, ?Integer indent_size, ?Integer indent_level) -> void

  attr_accessor use_color: bool

  def use_color?: () -> bool

  def reset_use_color: () -> bool

  attr_accessor track_eof: bool

  def track_eof?: () -> bool?

  attr_reader wrap_at: Integer?

  attr_reader page_at: Integer?

  attr_accessor multi_indent: bool?

  attr_accessor indent_size: Integer

  attr_accessor indent_level: Integer

  # nil for an output-only HighLine (HighLine.new(nil, output)).
  attr_reader input: _Input?

  attr_reader output: _Output

  # The key of the Hash being gathered (Question#gather).
  attr_accessor key: untyped

  attr_reader terminal: Terminal

  # Raises EOFError when the input is exhausted.
  def agree: (::String yes_or_no_question, ?(bool | :getc)? character) ?{ (Question question) -> void } -> bool

  # Returns the answer converted by the answer type (a String without one),
  # or an Array/Hash of answers with Question#gather.
  # Raises EOFError when the input is exhausted.
  def ask: (::String | Question template_or_question, ?untyped answer_type) ?{ (Question question) -> void } -> untyped

  # Returns the chosen item's name, or what its action returned.
  # Raises EOFError when the input is exhausted.
  def choose: (*untyped items) ?{ (Menu menu) -> void } -> untyped

  def color: (::String string, *style colors) -> ::String

  def color_code: (*style colors) -> ::String

  def uncolor: (::String string) -> ::String

  def list: (_ToAry[untyped] items, ?Symbol? mode, ?(Integer | ::String)? option) -> ::String

  def say: (_ToS? statement) -> void

  def render_and_ident_statement: (_ToS? statement) -> ::String

  def render_statement: (_ToS? statement) -> ::String

  def wrap_at=: (Integer | :auto | nil setting) -> Integer?

  def page_at=: (Integer | :auto | nil setting) -> Integer?

  def indentation: () -> ::String

  def indent: [T] (?Integer increase, ?_ToS? statement, ?bool? multiline) { (HighLine highline) -> T } -> T
            | (?Integer increase, ?_ToS? statement, ?bool? multiline) -> void

  def newline: () -> void

  def output_cols: () -> Integer

  def output_rows: () -> Integer

  def puts: (*untyped args) -> void

  def new_scope: () -> HighLine

  module BuiltinStyles
    STYLE_LIST: Hash[Symbol, ::String]
    STYLES: Array[::String]
    COLOR_LIST: Hash[Symbol, { code: ::String, rgb: Array[Integer] }]
    BASIC_COLORS: Array[::String]
    COLORS: Array[::String]

    BLACK: ::String
    BLACK_STYLE: HighLine::Style
    BLINK: ::String
    BLINK_STYLE: HighLine::Style
    BLUE: ::String
    BLUE_STYLE: HighLine::Style
    BOLD: ::String
