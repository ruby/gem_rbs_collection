    ON_BRIGHT_CYAN: ::String
    ON_BRIGHT_CYAN_STYLE: HighLine::Style
    ON_BRIGHT_GRAY: ::String
    ON_BRIGHT_GRAY_STYLE: HighLine::Style
    ON_BRIGHT_GREEN: ::String
