  #   ActionMailer::Base.preview_interceptors.delete(ActionMailer::InlinePreviewInterceptor)
  #
  class InlinePreviewInterceptor
    PATTERN: ::Regexp

    include ::Base64

    def self.previewing_email: (untyped message) -> untyped

    def initialize: (untyped message) -> void

    def transform!: () -> untyped

    private

    attr_reader message: untyped

    def html_part: () -> untyped

    def data_url: (untyped part) -> ::String

    def find_part: (untyped cid) -> untyped
  end
end

