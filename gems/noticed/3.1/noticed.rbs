module Noticed
  VERSION: String

  class ValidationError < StandardError
  end

  def self.parent_class: () -> String

  def self.parent_class=: (String value) -> String

  class ApplicationJob < ::ActiveJob::Base
  end

  class ApplicationRecord < ::ActiveRecord::Base
  end

  class EventJob < ApplicationJob
  end

  module Translation
    def translate: (String | Symbol key, **untyped options) -> String

    alias t translate
  end
end
