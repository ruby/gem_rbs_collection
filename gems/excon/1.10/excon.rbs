module Excon
  VERSION: String
  DEFAULT_CA_FILE: String

  type params = Hash[Symbol, untyped]
  type stub_response = params | ^(params) -> params
  type stub = [params, stub_response]

  def self.defaults: () -> Hash[Symbol, untyped]
  def self.defaults=: (Hash[Symbol, untyped]) -> Hash[Symbol, untyped]
  def self.new: (String url, ?params params) -> Connection
  def self.stub: (?params request_params, ?params? response_params) ?{ (params) -> params } -> stub
  def self.stubs: () -> Array[stub]
  def self.unstub: (?params request_params) -> stub?
  def self.connect: (String url, ?params params) -> Response
  def self.delete: (String url, ?params params) -> Response
  def self.get: (String url, ?params params) -> Response
  def self.head: (String url, ?params params) -> Response
  def self.options: (String url, ?params params) -> Response
  def self.patch: (String url, ?params params) -> Response
  def self.post: (String url, ?params params) -> Response
  def self.put: (String url, ?params params) -> Response
  def self.trace: (String url, ?params params) -> Response

  class Headers < Hash[String, String]
    def initialize: () -> void
    def []: (String | Symbol key) -> String?
    def []=: (String | Symbol key, String value) -> String
  end

  class Response
    attr_accessor data: Hash[Symbol, untyped]
    attr_accessor body: String
    attr_accessor headers: Headers
    attr_accessor status: Integer
    attr_accessor status_line: String?
    attr_accessor reason_phrase: String?
    attr_accessor remote_ip: String?
    attr_reader host: String?
    attr_reader scheme: String?
    attr_reader local_address: String?
    attr_reader local_port: Integer?
    attr_reader http_method: (Symbol | String)?
    attr_reader path: String?
    attr_reader query: (String | Hash[untyped, untyped])?
    attr_reader port: Integer?

    def initialize: (?Hash[Symbol, untyped] params) -> void
    def []: (Symbol key) -> untyped
    def get_header: (String name) -> String?
  end

  class Connection
    attr_reader data: Hash[Symbol, untyped]

    def initialize: (?params params) -> void
    def request: (?params params) -> Response
    def requests: (Array[params] pipeline_params) -> Array[Response]
    def batch_requests: (Array[params] pipeline_params, ?Integer? limit) -> Array[Response]
    def reset: () -> void
    def logger: () -> Logger?
    def logger=: (Logger logger) -> Logger

    def connect: (?params params) -> Response
    def delete: (?params params) -> Response
    def get: (?params params) -> Response
    def head: (?params params) -> Response
    def options: (?params params) -> Response
    def patch: (?params params) -> Response
    def post: (?params params) -> Response
    def put: (?params params) -> Response
    def trace: (?params params) -> Response
  end

  class Error < StandardError
    class Socket < Error
      attr_reader socket_error: Exception
      def initialize: (?Exception socket_error) -> void
    end

    class Certificate < Socket
    end

    class StubNotFound < Error
    end

    class InvalidStub < Error
    end

    class Warning < Error
    end

    class InvalidHeaderKey < Error
    end

    class InvalidHeaderValue < Error
    end

    class InvalidParameter < Error
    end

    class Timeout < Error
    end

    class ResponseParse < Error
    end

    class ProxyParse < Error
    end

    class TooManyRedirects < Error
    end

    class ProxyConnectionError < Error
      attr_reader request: params?
      attr_reader response: Response?
      def initialize: (String msg, ?params? request, ?Response? response) -> void
    end

    class HTTPStatus < Error
      attr_reader request: params?
      attr_reader response: Response?
      def initialize: (String msg, ?params? request, ?Response? response) -> void
    end

    class Informational < HTTPStatus
    end

    class Success < HTTPStatus
    end

    class Redirection < HTTPStatus
    end

    class Client < HTTPStatus
    end

    class Server < HTTPStatus
    end

    class Continue < Informational
    end

    class SwitchingProtocols < Informational
    end

    class OK < Success
    end

    class Created < Success
    end

    class Accepted < Success
    end

    class NonAuthoritativeInformation < Success
    end

    class NoContent < Success
    end

    class ResetContent < Success
    end

    class PartialContent < Success
    end

    class MultipleChoices < Redirection
    end

    class MovedPermanently < Redirection
    end

    class Found < Redirection
    end

    class SeeOther < Redirection
    end

    class NotModified < Redirection
    end

    class UseProxy < Redirection
    end

    class TemporaryRedirect < Redirection
    end

    class BadRequest < Client
    end

    class Unauthorized < Client
    end

    class PaymentRequired < Client
    end

    class Forbidden < Client
    end

    class NotFound < Client
    end

    class MethodNotAllowed < Client
    end

    class NotAcceptable < Client
    end

    class ProxyAuthenticationRequired < Client
    end

    class RequestTimeout < Client
    end

    class Conflict < Client
    end

    class Gone < Client
    end

    class LengthRequired < Client
    end

    class PreconditionFailed < Client
    end

    class RequestEntityTooLarge < Client
    end

    class RequestURITooLong < Client
    end

    class UnsupportedMediaType < Client
    end

    class RequestedRangeNotSatisfiable < Client
    end

    class ExpectationFailed < Client
    end

    class UnprocessableEntity < Client
    end

    class TooManyRequests < Client
    end

    class InternalServerError < Server
    end

    class NotImplemented < Server
    end

    class BadGateway < Server
    end

    class ServiceUnavailable < Server
    end

    class GatewayTimeout < Server
    end

    def self.status_errors: () -> Hash[Integer, [singleton(HTTPStatus), String]]
    def self.status_error: (params request, Response response) -> HTTPStatus
  end

  module Errors
    class Error = Excon::Error
    class StubNotFound = Excon::Error::StubNotFound
    class InvalidStub = Excon::Error::InvalidStub
    class Warning = Excon::Error::Warning
    class InvalidHeaderKey = Excon::Error::InvalidHeaderKey
    class InvalidHeaderValue = Excon::Error::InvalidHeaderValue
    class InvalidParameter = Excon::Error::InvalidParameter
    class Timeout = Excon::Error::Timeout
    class ResponseParse = Excon::Error::ResponseParse
    class ProxyParse = Excon::Error::ProxyParse
    class TooManyRedirects = Excon::Error::TooManyRedirects
    class ProxyConnectionError = Excon::Error::ProxyConnectionError
    class Informational = Excon::Error::Informational
    class Success = Excon::Error::Success
    class Redirection = Excon::Error::Redirection
    class Continue = Excon::Error::Continue
    class SwitchingProtocols = Excon::Error::SwitchingProtocols
    class OK = Excon::Error::OK
    class Created = Excon::Error::Created
    class Accepted = Excon::Error::Accepted
    class NonAuthoritativeInformation = Excon::Error::NonAuthoritativeInformation
    class NoContent = Excon::Error::NoContent
    class ResetContent = Excon::Error::ResetContent
    class PartialContent = Excon::Error::PartialContent
    class MultipleChoices = Excon::Error::MultipleChoices
    class MovedPermanently = Excon::Error::MovedPermanently
    class Found = Excon::Error::Found
    class SeeOther = Excon::Error::SeeOther
    class NotModified = Excon::Error::NotModified
    class UseProxy = Excon::Error::UseProxy
    class TemporaryRedirect = Excon::Error::TemporaryRedirect
    class BadRequest = Excon::Error::BadRequest
    class Unauthorized = Excon::Error::Unauthorized
    class PaymentRequired = Excon::Error::PaymentRequired
    class Forbidden = Excon::Error::Forbidden
    class NotFound = Excon::Error::NotFound
    class MethodNotAllowed = Excon::Error::MethodNotAllowed
    class NotAcceptable = Excon::Error::NotAcceptable
    class ProxyAuthenticationRequired = Excon::Error::ProxyAuthenticationRequired
    class RequestTimeout = Excon::Error::RequestTimeout
    class Conflict = Excon::Error::Conflict
    class Gone = Excon::Error::Gone
    class LengthRequired = Excon::Error::LengthRequired
    class PreconditionFailed = Excon::Error::PreconditionFailed
    class RequestEntityTooLarge = Excon::Error::RequestEntityTooLarge
    class RequestURITooLong = Excon::Error::RequestURITooLong
    class UnsupportedMediaType = Excon::Error::UnsupportedMediaType
    class RequestedRangeNotSatisfiable = Excon::Error::RequestedRangeNotSatisfiable
    class ExpectationFailed = Excon::Error::ExpectationFailed
    class UnprocessableEntity = Excon::Error::UnprocessableEntity
    class TooManyRequests = Excon::Error::TooManyRequests
    class InternalServerError = Excon::Error::InternalServerError
    class NotImplemented = Excon::Error::NotImplemented
    class BadGateway = Excon::Error::BadGateway
    class ServiceUnavailable = Excon::Error::ServiceUnavailable
    class GatewayTimeout = Excon::Error::GatewayTimeout
    class SocketError = Excon::Error::Socket
    class CertificateError = Excon::Error::Certificate
    class HTTPStatusError = Excon::Error::HTTPStatus
    class ClientError = Excon::Error::Client
    class ServerError = Excon::Error::Server

    def self.status_error: (params request, Response response) -> Error::HTTPStatus
  end

  module Middleware
    class Base
    end

    class Decompress < Base
    end

    class EscapePath < Base
    end

    class Expects < Base
    end

    class Idempotent < Base
    end

    class Instrumentor < Base
    end

    class Mock < Base
    end

    class RedirectFollower < Base
    end

    class ResponseParser < Base
    end
  end

  class StandardInstrumentor
    def self.instrument: (String name, ?params params) ?{ () -> untyped } -> untyped
  end

  class LoggingInstrumentor
    def self.instrument: (String name, ?params params) ?{ () -> untyped } -> untyped
  end
end
