# Module that adds descendant tracking to a class.
#
#   class Base
#     extend DescendantsTracker
#   end
module DescendantsTracker
  # Defined in descendants_tracker/version, which `require "descendants_tracker"` does not load.
  VERSION: String

  # Return the descendants of this class, most recently defined first.
  attr_reader descendants: Array[Class]
end
