      module ClassMethods
        # Broadcast a hash to a unique broadcasting for this array of `broadcastables` in this channel.
        def broadcast_to: (untyped broadcastables, untyped message) -> untyped

        private

        def serialize_broadcasting: (untyped object) -> untyped
      end

