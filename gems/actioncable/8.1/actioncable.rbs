# ClassMethods of the concerns included in the base classes and the ones they include
module ActionCable
  module Connection
    class Base
      extend ActionCable::Connection::Identification::ClassMethods
      extend ActionCable::Connection::Callbacks::ClassMethods
      extend ActiveSupport::Callbacks::ClassMethods
      extend ActiveSupport::Rescuable::ClassMethods
    end
  end

  module Channel
    class Base
      extend ActionCable::Channel::Callbacks::ClassMethods
      extend ActionCable::Channel::PeriodicTimers::ClassMethods
      extend ActionCable::Channel::Naming::ClassMethods
      extend ActionCable::Channel::Broadcasting::ClassMethods
      extend ActiveSupport::Callbacks::ClassMethods
      extend ActiveSupport::Rescuable::ClassMethods
    end
  end
end

# Return types of commonly used methods
module ActionCable
  def self?.server: () -> ActionCable::Server::Base

  module Connection
    class Base
      private

      def request: () -> ActionDispatch::Request

      def cookies: () -> ActionDispatch::Cookies::CookieJar
    end
  end

  module Channel
    class Base
      attr_reader params: ActiveSupport::HashWithIndifferentAccess[String, untyped]

      attr_reader connection: ActionCable::Connection::Base

      attr_reader identifier: String
    end

    module Broadcasting
      def broadcasting_for: (untyped model) -> String

      module ClassMethods
        def broadcasting_for: (untyped broadcastables) -> String
      end
    end

    module Naming
      def channel_name: () -> String

      module ClassMethods
        def channel_name: () -> String
      end
    end
  end
end
