    def group_by_period: (Symbol | String period, Symbol | String field, ?permit: Array[Symbol | String]?, ?time_zone: String | ::ActiveSupport::TimeZone | false | nil, ?series: bool, ?format: String | Proc, ?locale: Symbol | String, ?range: Range[::Groupdate::_ToTime?], ?expand_range: bool, ?reverse: bool, ?n: Integer, ?default_value: untyped, ?carry_forward: bool, ?last: Integer, ?current: bool, ?week_start: Symbol | String, ?day_start: Numeric) -> Relation
  end

  # Instance methods of a relation. Without a block they add the grouping to the
  # relation, with a block they group the loaded records.
  #
  # This module does not exist at runtime. groupdate adds these methods to
  # ::Enumerable (lib/groupdate/enumerable.rb), and on a relation they delegate
  # to the model's group_by_period. Groupdate::Relation, the module groupdate
  # includes into ActiveRecord::Relation, only overrides calculate, so the
