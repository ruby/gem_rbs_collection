# A model's class-side API and relation are declared in the model's own
# signature. Include `Enumerable` before `ActiveRecord::Relation::Methods`, so
# that the relation's `group_by_*` take precedence over `Enumerable`'s:
#
#   class User < ApplicationRecord
#     extend ::ActiveRecord::Base::ClassMethods[::User, ::User::ActiveRecord_Relation, ::Integer]
#
#     class ActiveRecord_Relation < ::ActiveRecord::Relation
#       include ::Enumerable[::User]
#       include ::ActiveRecord::Relation::Methods[::User, ::Integer]
#     end
#   end
#
# `count` and `sum` on a grouped relation return a Hash at runtime, but are
# typed as in activerecord (Integer).
module Groupdate
  VERSION: String

  PERIODS: Array[Symbol]
  METHODS: Array[Symbol]

  interface _ToTime
    def to_time: () -> Time
  end

  class Error < RuntimeError
  end

  def self.week_start: () -> (Symbol | String)
  def self.week_start=: ((Symbol | String) value) -> (Symbol | String)

  def self.day_start: () -> Numeric
  def self.day_start=: (Numeric value) -> Numeric

  def self.time_zone: () -> (String | ::ActiveSupport::TimeZone | false | nil)
  def self.time_zone=: (String | ::ActiveSupport::TimeZone | false | nil value) -> (String | ::ActiveSupport::TimeZone | false | nil)

