    # enum :status, %i[ pending processing delivered failed bounced ]
    def pending?: () -> bool

    def pending!: () -> void

    def processing?: () -> bool

    def processing!: () -> void

    def delivered?: () -> bool

    def delivered!: () -> void

    def failed?: () -> bool

