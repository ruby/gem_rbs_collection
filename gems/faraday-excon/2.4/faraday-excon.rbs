module Faraday
  class Adapter
    # Faraday adapter that sends requests with Excon. Register it with
    # `builder.adapter :excon`; the options Hash given to the adapter is
    # merged into the options for `Excon.new` (`persistent: true` reuses
    # the connection).
    class Excon < Faraday::Adapter
      # Builds an Excon connection for the env's URL (path and query
      # removed) with the SSL, timeout and proxy options of the env, or
      # returns the previous one when the adapter is persistent.
      # Faraday::Adapter#connection also passes a Hash with :url, :request
      # and :ssl keys.
      def build_connection: (Faraday::Env | Hash[Symbol, untyped] env) -> ::Excon::Connection

      # Raises Faraday::ConnectionFailed, Faraday::TimeoutError or
      # Faraday::SSLError when Excon fails.
      def call: (Faraday::Env env) -> Faraday::Response

      # The request body, read first when it is IO-like.
      def read_body: (Faraday::Env env) -> String?
    end
  end

  module Excon
    VERSION: String
  end
end
