module Rouge
  def self.version: () -> String

  def self.highlight: (String text, Lexer | singleton(Lexer) | String lexer, Formatter | singleton(Formatter) | String formatter) -> String
                    | (String text, Lexer | singleton(Lexer) | String lexer, Formatter | singleton(Formatter) | String formatter) { (String) -> void } -> void

  def self.eager_load!: () -> void
end
