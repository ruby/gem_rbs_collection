module ActiveJob
  module Serializers
    # Base class for serializing and deserializing custom objects.
    #
    # Example:
    #
    #   class MoneySerializer < ActiveJob::Serializers::ObjectSerializer
    #     def serialize(money)
    #       super("amount" => money.amount, "currency" => money.currency)
    #     end
    #
    #     def deserialize(hash)
    #       Money.new(hash["amount"], hash["currency"])
    #     end
    #
    #     def klass
    #       Money
    #     end
    #   end
    class ObjectSerializer
      def self.serialize?: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
      def self.serialize: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
      def self.deserialize: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped

      include ::Singleton

      def initialize: () -> void

      # Determines if an argument should be serialized by a serializer.
      def serialize?: (untyped argument) -> untyped

      # Serializes an argument to a JSON primitive type.
      def serialize: (untyped hash) -> untyped

      # Deserializes an argument from a JSON primitive type.
      def deserialize: (untyped hash) -> untyped
    end
  end
end

