          def filter: (hashable filter) -> self
                    | () { (Filter) [self: Filter] -> void } -> self
        end

        class FunctionScore
          include BaseComponent

          def script_score: (untyped value) -> Hash[Symbol, untyped]

          def boost: (untyped value) -> Hash[Symbol, untyped]

          def max_boost: (untyped value) -> Hash[Symbol, untyped]

          def score_mode: (untyped value) -> Hash[Symbol, untyped]

          def boost_mode: (untyped value) -> Hash[Symbol, untyped]

          def query: (hashable query) -> self
                   | () { (Query) [self: Query] -> void } -> self

          def filter: (hashable filter) -> self
                    | () { (Filter) [self: Filter] -> void } -> self

          def functions: () -> Array[untyped]
                       | (Array[untyped] value) -> Array[untyped]

          def functions=: (Array[untyped] value) -> Array[untyped]
        end

        class Fuzzy
          include BaseComponent

          def value: (untyped value) -> Hash[Symbol, untyped]

