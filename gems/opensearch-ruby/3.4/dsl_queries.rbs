module OpenSearch
  module DSL
    module Search
      # Builds one query. Each method below creates the query of the same name
      class Query
        def bool: (*untyped args) ?{ (Queries::Bool) [self: Queries::Bool] -> void } -> Queries::Bool

        def boosting: (*untyped args) ?{ (Queries::Boosting) [self: Queries::Boosting] -> void } -> Queries::Boosting

        def common: (*untyped args) ?{ (Queries::Common) [self: Queries::Common] -> void } -> Queries::Common

        def constant_score: (*untyped args) ?{ (Queries::ConstantScore) [self: Queries::ConstantScore] -> void } -> Queries::ConstantScore

        def dis_max: (*untyped args) ?{ (Queries::DisMax) [self: Queries::DisMax] -> void } -> Queries::DisMax

        def exists: (*untyped args) ?{ (Queries::Exists) [self: Queries::Exists] -> void } -> Queries::Exists

        def filtered: (*untyped args) ?{ (Queries::Filtered) [self: Queries::Filtered] -> void } -> Queries::Filtered

        def function_score: (*untyped args) ?{ (Queries::FunctionScore) [self: Queries::FunctionScore] -> void } -> Queries::FunctionScore

        def fuzzy: (*untyped args) ?{ (Queries::Fuzzy) [self: Queries::Fuzzy] -> void } -> Queries::Fuzzy

        def fuzzy_like_this: (*untyped args) ?{ (Queries::FuzzyLikeThis) [self: Queries::FuzzyLikeThis] -> void } -> Queries::FuzzyLikeThis

        def fuzzy_like_this_field: (*untyped args) ?{ (Queries::FuzzyLikeThisField) [self: Queries::FuzzyLikeThisField] -> void } -> Queries::FuzzyLikeThisField

        def geo_shape: (*untyped args) ?{ (Queries::GeoShape) [self: Queries::GeoShape] -> void } -> Queries::GeoShape

        def has_child: (*untyped args) ?{ (Queries::HasChild) [self: Queries::HasChild] -> void } -> Queries::HasChild

        def has_parent: (*untyped args) ?{ (Queries::HasParent) [self: Queries::HasParent] -> void } -> Queries::HasParent

        def ids: (*untyped args) ?{ (Queries::Ids) [self: Queries::Ids] -> void } -> Queries::Ids

        def indices: (*untyped args) ?{ (Queries::Indices) [self: Queries::Indices] -> void } -> Queries::Indices

        def match: (*untyped args) ?{ (Queries::Match) [self: Queries::Match] -> void } -> Queries::Match

        def match_all: (*untyped args) ?{ (Queries::MatchAll) [self: Queries::MatchAll] -> void } -> Queries::MatchAll

        def match_phrase: (*untyped args) ?{ (Queries::MatchPhrase) [self: Queries::MatchPhrase] -> void } -> Queries::MatchPhrase

        def match_phrase_prefix: (*untyped args) ?{ (Queries::MatchPhrasePrefix) [self: Queries::MatchPhrasePrefix] -> void } -> Queries::MatchPhrasePrefix

        def more_like_this: (*untyped args) ?{ (Queries::MoreLikeThis) [self: Queries::MoreLikeThis] -> void } -> Queries::MoreLikeThis

        def multi_match: (*untyped args) ?{ (Queries::MultiMatch) [self: Queries::MultiMatch] -> void } -> Queries::MultiMatch

        def nested: (*untyped args) ?{ (Queries::Nested) [self: Queries::Nested] -> void } -> Queries::Nested

        def prefix: (*untyped args) ?{ (Queries::Prefix) [self: Queries::Prefix] -> void } -> Queries::Prefix

        def query_string: (*untyped args) ?{ (Queries::QueryString) [self: Queries::QueryString] -> void } -> Queries::QueryString

        def range: (*untyped args) ?{ (Queries::Range) [self: Queries::Range] -> void } -> Queries::Range

        def regexp: (*untyped args) ?{ (Queries::Regexp) [self: Queries::Regexp] -> void } -> Queries::Regexp

        def script_score: (*untyped args) ?{ (Queries::ScriptScore) [self: Queries::ScriptScore] -> void } -> Queries::ScriptScore

        def simple_query_string: (*untyped args) ?{ (Queries::SimpleQueryString) [self: Queries::SimpleQueryString] -> void } -> Queries::SimpleQueryString

        def span_first: (*untyped args) ?{ (Queries::SpanFirst) [self: Queries::SpanFirst] -> void } -> Queries::SpanFirst

        def span_multi: (*untyped args) ?{ (Queries::SpanMulti) [self: Queries::SpanMulti] -> void } -> Queries::SpanMulti

        def span_near: (*untyped args) ?{ (Queries::SpanNear) [self: Queries::SpanNear] -> void } -> Queries::SpanNear

        def span_not: (*untyped args) ?{ (Queries::SpanNot) [self: Queries::SpanNot] -> void } -> Queries::SpanNot

        def span_or: (*untyped args) ?{ (Queries::SpanOr) [self: Queries::SpanOr] -> void } -> Queries::SpanOr

        def span_term: (*untyped args) ?{ (Queries::SpanTerm) [self: Queries::SpanTerm] -> void } -> Queries::SpanTerm

        def template: (*untyped args) ?{ (Queries::Template) [self: Queries::Template] -> void } -> Queries::Template

        def term: (*untyped args) ?{ (Queries::Term) [self: Queries::Term] -> void } -> Queries::Term

        def terms: (*untyped args) ?{ (Queries::Terms) [self: Queries::Terms] -> void } -> Queries::Terms

        def top_children: (*untyped args) ?{ (Queries::TopChildren) [self: Queries::TopChildren] -> void } -> Queries::TopChildren

        def wildcard: (*untyped args) ?{ (Queries::Wildcard) [self: Queries::Wildcard] -> void } -> Queries::Wildcard

        def to_hash: (?Hash[Symbol, untyped] options) -> Hash[Symbol, untyped]
      end

      module Queries
        class Bool
          include BaseComponent

          def minimum_should_match: (untyped value) -> Hash[Symbol, untyped]

          def boost: (untyped value) -> Hash[Symbol, untyped]

          def must: (hashable query) -> self
                  | () { (Query) [self: Query] -> void } -> self

          def must_not: (hashable query) -> self
                      | () { (Query) [self: Query] -> void } -> self

          def should: (hashable query) -> self
                    | () { (Query) [self: Query] -> void } -> self

          def filter: (hashable filter) -> self
                    | () { (Filter) [self: Filter] -> void } -> self
        end

        class Boosting
          include BaseComponent

          def positive: (untyped value) -> Hash[Symbol, untyped]

          def negative: (untyped value) -> Hash[Symbol, untyped]

          def negative_boost: (untyped value) -> Hash[Symbol, untyped]
        end

        class Common
          include BaseComponent

          def query: (untyped value) -> Hash[Symbol, untyped]

          def cutoff_frequency: (untyped value) -> Hash[Symbol, untyped]

          def low_freq_operator: (untyped value) -> Hash[Symbol, untyped]

          def minimum_should_match: (untyped value) -> Hash[Symbol, untyped]

          def boost: (untyped value) -> Hash[Symbol, untyped]

          def analyzer: (untyped value) -> Hash[Symbol, untyped]

          def disable_coord: (untyped value) -> Hash[Symbol, untyped]
        end

        class ConstantScore
          include BaseComponent

          def boost: (untyped value) -> Hash[Symbol, untyped]

          def query: (hashable query) -> self
                   | () { (Query) [self: Query] -> void } -> self

          def filter: (hashable filter) -> self
                    | () { (Filter) [self: Filter] -> void } -> self
        end

        class DisMax
          include BaseComponent

          def queries: (untyped value) -> Hash[Symbol, untyped]

