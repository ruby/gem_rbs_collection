        end

        class Exists
          include BaseComponent

          def field: (untyped value) -> Hash[Symbol, untyped]
        end

        class Filtered
          include BaseComponent

          def strategy: (untyped value) -> Hash[Symbol, untyped]

          def query: (hashable query) -> self
