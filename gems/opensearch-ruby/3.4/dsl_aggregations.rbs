module OpenSearch
  module DSL
    module Search
      class AggregationsCollection < Hash[untyped, untyped]
        def to_hash: () -> Hash[untyped, untyped]
      end

      class Aggregation
        def avg: (*untyped args) ?{ (Aggregations::Avg) [self: Aggregations::Avg] -> void } -> Aggregations::Avg

        def cardinality: (*untyped args) ?{ (Aggregations::Cardinality) [self: Aggregations::Cardinality] -> void } -> Aggregations::Cardinality

        def children: (*untyped args) ?{ (Aggregations::Children) [self: Aggregations::Children] -> void } -> Aggregations::Children

        def composite: (*untyped args) ?{ (Aggregations::Composite) [self: Aggregations::Composite] -> void } -> Aggregations::Composite

        def date_histogram: (*untyped args) ?{ (Aggregations::DateHistogram) [self: Aggregations::DateHistogram] -> void } -> Aggregations::DateHistogram

        def date_range: (*untyped args) ?{ (Aggregations::DateRange) [self: Aggregations::DateRange] -> void } -> Aggregations::DateRange

        def extended_stats: (*untyped args) ?{ (Aggregations::ExtendedStats) [self: Aggregations::ExtendedStats] -> void } -> Aggregations::ExtendedStats

        def filter: (*untyped args) ?{ (Aggregations::Filter) [self: Aggregations::Filter] -> void } -> Aggregations::Filter

        def filters: (*untyped args) ?{ (Aggregations::Filters) [self: Aggregations::Filters] -> void } -> Aggregations::Filters

        def geo_bounds: (*untyped args) ?{ (Aggregations::GeoBounds) [self: Aggregations::GeoBounds] -> void } -> Aggregations::GeoBounds

        def geo_distance: (*untyped args) ?{ (Aggregations::GeoDistance) [self: Aggregations::GeoDistance] -> void } -> Aggregations::GeoDistance

        def geohash_grid: (*untyped args) ?{ (Aggregations::GeohashGrid) [self: Aggregations::GeohashGrid] -> void } -> Aggregations::GeohashGrid

        def global: (*untyped args) ?{ (Aggregations::Global) [self: Aggregations::Global] -> void } -> Aggregations::Global

        def histogram: (*untyped args) ?{ (Aggregations::Histogram) [self: Aggregations::Histogram] -> void } -> Aggregations::Histogram

        def ip_range: (*untyped args) ?{ (Aggregations::IpRange) [self: Aggregations::IpRange] -> void } -> Aggregations::IpRange

        def max: (*untyped args) ?{ (Aggregations::Max) [self: Aggregations::Max] -> void } -> Aggregations::Max

        def min: (*untyped args) ?{ (Aggregations::Min) [self: Aggregations::Min] -> void } -> Aggregations::Min

        def missing: (*untyped args) ?{ (Aggregations::Missing) [self: Aggregations::Missing] -> void } -> Aggregations::Missing

        def nested: (*untyped args) ?{ (Aggregations::Nested) [self: Aggregations::Nested] -> void } -> Aggregations::Nested

        def percentile_ranks: (*untyped args) ?{ (Aggregations::PercentileRanks) [self: Aggregations::PercentileRanks] -> void } -> Aggregations::PercentileRanks

        def percentiles: (*untyped args) ?{ (Aggregations::Percentiles) [self: Aggregations::Percentiles] -> void } -> Aggregations::Percentiles

        def range: (*untyped args) ?{ (Aggregations::Range) [self: Aggregations::Range] -> void } -> Aggregations::Range

        def reverse_nested: (*untyped args) ?{ (Aggregations::ReverseNested) [self: Aggregations::ReverseNested] -> void } -> Aggregations::ReverseNested

        def scripted_metric: (*untyped args) ?{ (Aggregations::ScriptedMetric) [self: Aggregations::ScriptedMetric] -> void } -> Aggregations::ScriptedMetric

        def significant_terms: (*untyped args) ?{ (Aggregations::SignificantTerms) [self: Aggregations::SignificantTerms] -> void } -> Aggregations::SignificantTerms

        def stats: (*untyped args) ?{ (Aggregations::Stats) [self: Aggregations::Stats] -> void } -> Aggregations::Stats

        def sum: (*untyped args) ?{ (Aggregations::Sum) [self: Aggregations::Sum] -> void } -> Aggregations::Sum

        def terms: (*untyped args) ?{ (Aggregations::Terms) [self: Aggregations::Terms] -> void } -> Aggregations::Terms

        def top_hits: (*untyped args) ?{ (Aggregations::TopHits) [self: Aggregations::TopHits] -> void } -> Aggregations::TopHits

        def value_count: (*untyped args) ?{ (Aggregations::ValueCount) [self: Aggregations::ValueCount] -> void } -> Aggregations::ValueCount

        def avg_bucket: (*untyped args) ?{ (Aggregations::AvgBucket) [self: Aggregations::AvgBucket] -> void } -> Aggregations::AvgBucket

        def bucket_script: (*untyped args) ?{ (Aggregations::BucketScript) [self: Aggregations::BucketScript] -> void } -> Aggregations::BucketScript

        def bucket_selector: (*untyped args) ?{ (Aggregations::BucketSelector) [self: Aggregations::BucketSelector] -> void } -> Aggregations::BucketSelector

        def bucket_sort: (*untyped args) ?{ (Aggregations::BucketSort) [self: Aggregations::BucketSort] -> void } -> Aggregations::BucketSort

        def cumulative_sum: (*untyped args) ?{ (Aggregations::CumulativeSum) [self: Aggregations::CumulativeSum] -> void } -> Aggregations::CumulativeSum

        def derivative: (*untyped args) ?{ (Aggregations::Derivative) [self: Aggregations::Derivative] -> void } -> Aggregations::Derivative

        def extended_stats_bucket: (*untyped args) ?{ (Aggregations::ExtendedStatsBucket) [self: Aggregations::ExtendedStatsBucket] -> void } -> Aggregations::ExtendedStatsBucket

        def max_bucket: (*untyped args) ?{ (Aggregations::MaxBucket) [self: Aggregations::MaxBucket] -> void } -> Aggregations::MaxBucket

        def min_bucket: (*untyped args) ?{ (Aggregations::MinBucket) [self: Aggregations::MinBucket] -> void } -> Aggregations::MinBucket

        def moving_avg: (*untyped args) ?{ (Aggregations::MovingAvg) [self: Aggregations::MovingAvg] -> void } -> Aggregations::MovingAvg

        def percentiles_bucket: (*untyped args) ?{ (Aggregations::PercentilesBucket) [self: Aggregations::PercentilesBucket] -> void } -> Aggregations::PercentilesBucket

        def serial_diff: (*untyped args) ?{ (Aggregations::SerialDiff) [self: Aggregations::SerialDiff] -> void } -> Aggregations::SerialDiff

        def stats_bucket: (*untyped args) ?{ (Aggregations::StatsBucket) [self: Aggregations::StatsBucket] -> void } -> Aggregations::StatsBucket

        def sum_bucket: (*untyped args) ?{ (Aggregations::SumBucket) [self: Aggregations::SumBucket] -> void } -> Aggregations::SumBucket

        def aggregation: (*untyped args) ?{ (Aggregation) [self: Aggregation] -> void } -> untyped

        def aggregations: () -> AggregationsCollection?

        def to_hash: (?Hash[Symbol, untyped] options) -> untyped
      end

