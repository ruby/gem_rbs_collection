      module Aggregations
        class Avg
          include BaseComponent
        end

        class Cardinality
          include BaseComponent

          def field: (untyped value) -> Hash[Symbol, untyped]

          def precision_threshold: (untyped value) -> Hash[Symbol, untyped]

          def rehash: (untyped value) -> Hash[Symbol, untyped]

          def script: (untyped value) -> Hash[Symbol, untyped]

          def params: (untyped value) -> Hash[Symbol, untyped]
        end

        class Children
          include BaseAggregationComponent

          def type: (untyped value) -> Hash[Symbol, untyped]
        end

        class Composite
          include BaseAggregationComponent

          def size: (untyped value) -> Hash[Symbol, untyped]

          def sources: (untyped value) -> Hash[Symbol, untyped]

          def after: (untyped value) -> Hash[Symbol, untyped]
        end

