          def post_zone: (untyped value) -> Hash[Symbol, untyped]

          def time_zone: (untyped value) -> Hash[Symbol, untyped]

          def pre_zone_adjust_large_interval: (untyped value) -> Hash[Symbol, untyped]

          def pre_offset: (untyped value) -> Hash[Symbol, untyped]

          def post_offset: (untyped value) -> Hash[Symbol, untyped]

          def format: (untyped value) -> Hash[Symbol, untyped]

