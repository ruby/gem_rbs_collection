module OpenSearch
  VERSION: String

  class Client
    include API::Actions
    include API::Cluster
    include API::Indices

    def initialize: (?Hash[Symbol, untyped] arguments) ?{ (Faraday::Connection) -> void } -> void
  end

  class UnsupportedProductError < StandardError
  end

  module Transport
    module Transport
      class Error < StandardError
      end

      class ServerError < Error
      end

      module Errors
        class MultipleChoices < ServerError
        end

        class MovedPermanently < ServerError
        end

        class Found < ServerError
        end

        class SeeOther < ServerError
        end

        class NotModified < ServerError
        end

        class UseProxy < ServerError
        end

        class TemporaryRedirect < ServerError
        end

        class PermanentRedirect < ServerError
        end

        class BadRequest < ServerError
        end

        class Unauthorized < ServerError
        end

        class PaymentRequired < ServerError
        end

        class Forbidden < ServerError
        end

        class NotFound < ServerError
        end

        class MethodNotAllowed < ServerError
        end

        class NotAcceptable < ServerError
        end

        class ProxyAuthenticationRequired < ServerError
        end

        class RequestTimeout < ServerError
        end

        class Conflict < ServerError
        end

        class Gone < ServerError
        end

        class LengthRequired < ServerError
        end

        class PreconditionFailed < ServerError
        end

        class RequestEntityTooLarge < ServerError
        end

        class RequestURITooLong < ServerError
        end

        class UnsupportedMediaType < ServerError
        end

        class RequestedRangeNotSatisfiable < ServerError
        end

        class ExpectationFailed < ServerError
        end

        class ImATeapot < ServerError
        end

        class TooManyConnectionsFromThisIP < ServerError
        end

        class UpgradeRequired < ServerError
        end

        class TooManyRequests < ServerError
        end

        class BlockedByWindowsParentalControls < ServerError
        end

        class RequestHeaderTooLarge < ServerError
        end

        class HTTPToHTTPS < ServerError
        end

        class ClientClosedRequest < ServerError
        end

        class InternalServerError < ServerError
        end

        class NotImplemented < ServerError
        end

        class BadGateway < ServerError
        end

        class ServiceUnavailable < ServerError
        end

        class GatewayTimeout < ServerError
        end

        class HTTPVersionNotSupported < ServerError
        end

        class VariantAlsoNegotiates < ServerError
        end

        class NotExtended < ServerError
        end
      end

      module Serializer
        class MultiJson
          def initialize: (?untyped transport) -> void

          def load: (String string, ?Hash[Symbol, untyped] options) -> untyped

          def dump: (untyped object, ?Hash[Symbol, untyped] options) -> String
        end
      end
    end
  end
end
