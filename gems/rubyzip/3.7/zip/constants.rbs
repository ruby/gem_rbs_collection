  FSTYPE_ATARI: Integer
  FSTYPE_HPFS: Integer
  FSTYPE_MAC: Integer
  FSTYPE_Z_SYSTEM: Integer
  FSTYPE_CPM: Integer
  FSTYPE_TOPS20: Integer
  FSTYPE_NTFS: Integer
  FSTYPE_QDOS: Integer
  FSTYPE_ACORN: Integer
  FSTYPE_VFAT: Integer
