  FSTYPE_BEOS: Integer
  FSTYPE_TANDEM: Integer
  FSTYPE_THEOS: Integer
  FSTYPE_MAC_OSX: Integer
  FSTYPE_ATHEOS: Integer

  FSTYPES: Hash[Integer, String]

  COMPRESSION_METHOD_STORE: Integer
