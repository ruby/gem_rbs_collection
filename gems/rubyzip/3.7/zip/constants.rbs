  COMPRESSION_METHOD_REDUCE_1: Integer
  COMPRESSION_METHOD_REDUCE_2: Integer
  COMPRESSION_METHOD_REDUCE_3: Integer
  COMPRESSION_METHOD_REDUCE_4: Integer
  COMPRESSION_METHOD_IMPLODE: Integer
  COMPRESSION_METHOD_DEFLATE: Integer
  COMPRESSION_METHOD_DEFLATE_64: Integer
  COMPRESSION_METHOD_PKWARE_DCLI: Integer
  COMPRESSION_METHOD_BZIP2: Integer
