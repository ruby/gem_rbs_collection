module Zip
  class ExtraField
    class AES < ExtraField::Generic
      HEADER_ID: String

      attr_accessor vendor_version: Integer?
      attr_accessor vendor_id: String?
      attr_accessor encryption_strength: Integer?
      attr_accessor compression_method: Integer?

      def initialize: (?String? binstr) -> void

      def merge: (String binstr) -> void

      def suppress?: () -> bool

      def pack_for_local: () -> String

      def pack_for_c_dir: () -> String

      def ==: (untyped other) -> bool
    end
  end
end
