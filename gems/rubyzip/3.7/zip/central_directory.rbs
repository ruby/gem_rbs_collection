module Zip
  # Holds Entry objects, and StreamableStream wrappers (a DelegateClass of
  # Entry) for entries written with Zip::File#get_output_stream.
  class CentralDirectory
    include Dirtyable
    extend Dirtyable::ClassMethods

    END_OF_CD_SIG: Integer
    ZIP64_END_OF_CD_SIG: Integer
    ZIP64_EOCD_LOCATOR_SIG: Integer
    STATIC_EOCD_SIZE: Integer
    ZIP64_STATIC_EOCD_SIZE: Integer
    ZIP64_EOCD_LOC_SIZE: Integer
    MAX_FILE_COMMENT_SIZE: Integer
    MAX_END_OF_CD_SIZE: Integer

    attr_accessor comment: String

    def initialize: (?EntrySet | Array[Entry | StreamableStream] entries, ?String comment) -> void

    def <<: (Entry | StreamableStream entry) -> void

    # Returns the argument when an entry with that name was removed.
    def delete: (Entry entry) -> Entry?
              | (StreamableStream entry) -> StreamableStream?
              | (String entry) -> String?

    def each: () { (Entry | StreamableStream) -> void } -> Array[Entry | StreamableStream]
            | () -> Enumerator[Entry | StreamableStream, Array[Entry | StreamableStream]]

    def entries: () -> Array[Entry | StreamableStream]

    def find_entry: (String | Entry | StreamableStream entry_name) -> (Entry | StreamableStream)?

    def glob: (String pattern, ?Integer flags) ?{ (Entry | StreamableStream) -> void } -> Array[Entry | StreamableStream]

    def include?: (Entry | StreamableStream | String entry) -> bool

    def size: () -> Integer

    def read_from_stream: (IO | StringIO io) -> void

    def write_to_stream: (IO | StringIO | Tempfile io, ?suppress_extra_fields: bool | Symbol | Array[Symbol]) -> void

    def count_entries: (IO | StringIO io) -> Integer

    def ==: (untyped other) -> bool
  end
end
