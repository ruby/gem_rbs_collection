module Zip
  module FileSystem
    class DirectoryIterator
      include Enumerable[String]

      def initialize: (Array[String] filenames) -> void

      def close: () -> void

      def each: () { (String) -> void } -> Array[String]
              | () -> Enumerator[String, Array[String]]

      def read: () -> String?

      def rewind: () -> Integer

      def seek: (Integer position) -> Integer

      def tell: () -> Integer
    end
  end
end
