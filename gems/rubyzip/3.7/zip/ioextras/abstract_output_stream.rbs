module Zip
  module IOExtras
    module AbstractOutputStream
      include FakeIO

      def write: (String data) -> Integer

      def print: (*untyped params) -> nil

      def printf: (String a_format_string, *untyped params) -> nil

      def putc: (Integer an_object) -> Integer
              | (String an_object) -> String

      def puts: (*untyped params) -> void
    end
  end
end
