module Zip
  class Deflater < Compressor
    attr_reader size: Integer
    attr_reader crc: Integer

    def initialize: (IO | StringIO | Tempfile output_stream, ?Integer level, ?Encrypter encrypter) -> void

    # Returns the output stream.
    def <<: (String data) -> (IO | StringIO | Tempfile)

    def finish: () -> void
  end
end
