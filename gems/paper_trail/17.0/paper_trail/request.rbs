module PaperTrail
  module Request
    def self.controller_info=: (Hash[Symbol, untyped]? value) -> void

    def self.controller_info: () -> Hash[Symbol, untyped]?

    def self.disable_model: (_ToS model_class) -> void

    def self.enable_model: (_ToS model_class) -> void

    def self.enabled=: (boolish value) -> void

    def self.enabled?: () -> bool

    def self.enabled_for_model: (_ToS model, boolish value) -> void

