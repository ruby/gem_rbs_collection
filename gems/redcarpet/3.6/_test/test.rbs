class HeadingRenderer < Redcarpet::Render::HTML
  def header: (String text, Integer header_level) -> String

  def block_code: (String code, String? language) -> String

  def image: (String link, String? title, String? alt_text) -> String

  def postprocess: (String document) -> String
end

class Slack < Redcarpet::Render::Base
  @prefix: String

  def initialize: (String prefix) -> void

  def paragraph: (String text) -> String
end
