module Google
  # Module Auth provides classes that provide Google-specific authorization
  # used to access Google APIs.
  module Auth
    # An IO-like object the JSON key is read from (File, StringIO, ...).
    interface _JsonKeyIO
      def read: () -> String?
    end

    # JsonKeyReader contains the behaviour used to read private key and
    # client email fields from the service account
    module JsonKeyReader
      # Returns the private key, client email, project ID, quota project ID
      # and universe domain from the JSON key.
      #
      # Raises Google::Auth::InitializationError for invalid JSON or when
      # client_email or private_key is missing.
      def read_json_key: (_JsonKeyIO json_key_io) -> [String, String, String?, String?, String?]
    end
  end
end
