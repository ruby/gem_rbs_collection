module Google
  # Module Auth provides classes that provide Google-specific authorization
  # used to access Google APIs.
  module Auth
    # Authenticates requests using Google's Service Account credentials via an
    # OAuth access token.
    #
    # This class allows authorizing requests for service accounts directly
    # from credentials from a json key file downloaded from the developer
    # console (via 'Generate new Json Key').
    #
    # cf [Application Default Credentials](https://cloud.google.com/docs/authentication/production)
    class ServiceAccountCredentials < Signet::OAuth2::Client
      @project_id: String?

      @quota_project_id: String?

      @enable_self_signed_jwt: bool

      TOKEN_CRED_URI: String

      extend CredentialsLoader

      extend JsonKeyReader

      attr_reader project_id: String?

      attr_reader quota_project_id: String?

      def enable_self_signed_jwt?: () -> bool

      # Creates a ServiceAccountCredentials.
      #
      # Recognized options: `:json_key_io` (an IO the JSON key is read from;
      # without it the key is read from the GOOGLE_PRIVATE_KEY and
      # GOOGLE_CLIENT_EMAIL environment variables), `:scope`,
      # `:enable_self_signed_jwt`, `:target_audience`, `:audience`,
      # `:token_credential_uri`, `:default_connection` and
      # `:connection_builder`.
      #
      # Raises ArgumentError if both scope and target_audience are given, and
      # Google::Auth::InitializationError for an invalid or incomplete key.
      def self.make_creds: (?::Hash[untyped, untyped] options) -> instance

      # Creates a duplicate of these credentials without the cached token.
      def duplicate: (?::Hash[untyped, untyped] options) -> self

      # Handles certain escape sequences that sometimes appear in input.
      # Specifically, interprets the "\n" sequence for newline, and removes
      # enclosing quotes.
      def self.unescape: (String str) -> String
                       | (String? str) -> String?

      def initialize: (?::Hash[untyped, untyped] options) -> void

      # Extends the base class to use a transient
      # ServiceAccountJwtHeaderCredentials for certain cases.
      #
      # Returns the authorization header value, or the updated hash when a
      # self-signed JWT is used.
      def apply!: (::Hash[untyped, untyped] a_hash, ?::Hash[untyped, untyped] opts) -> (String | ::Hash[untyped, untyped])

      # Modifies this logic so it also requires self-signed-jwt to be disabled
      def needs_access_token?: () -> bool

      # Destructively updates these credentials.
      def update!: (?::Hash[untyped, untyped] options) -> self

      private

      def apply_self_signed_jwt!: (::Hash[untyped, untyped] a_hash) -> ::Hash[untyped, untyped]
    end

    # Authenticates requests using Google's Service Account credentials via
    # JWT Header.
    #
    # This class allows authorizing requests for service accounts directly
    # from credentials from a json key file downloaded from the developer
    # console (via 'Generate new Json Key').  It is not part of any OAuth2
    # flow, rather it creates a JWT and sends that as a credential.
    #
    # cf [Application Default Credentials](https://cloud.google.com/docs/authentication/production)
    class ServiceAccountJwtHeaderCredentials
      @private_key: String?

      @issuer: String?

      @project_id: String?

      @quota_project_id: String?

      @universe_domain: String

      @signing_key: OpenSSL::PKey::RSA

      @scope: (String | Array[String])?

      JWT_AUD_URI_KEY: :jwt_aud_uri

      AUTH_METADATA_KEY: Symbol

      TOKEN_CRED_URI: String

      SIGNING_ALGORITHM: String

      EXPIRY: 60

      extend CredentialsLoader

      extend JsonKeyReader

      attr_reader project_id: String?

      attr_reader quota_project_id: String?

      attr_accessor universe_domain: String

      attr_accessor logger: ::Logger?

      # Create a ServiceAccountJwtHeaderCredentials.
      #
      # @param json_key_io [IO] an IO from which the JSON key can be read
      # @param scope [string|array|nil] the scope(s) to access
      def self.make_creds: (?::Hash[untyped, untyped] options) -> instance

      # Initializes a ServiceAccountJwtHeaderCredentials.
      #
      # @param json_key_io [IO] an IO from which the JSON key can be read
      def initialize: (?::Hash[untyped, untyped] options) -> void

      # Creates a duplicate of these credentials.
      def duplicate: (?::Hash[untyped, untyped] options) -> self

      # Construct a jwt token if the JWT_AUD_URI key is present in the input
      # hash.
      #
      # The jwt token is used as the value of a 'Bearer '.
      def apply!: [T < ::Hash[untyped, untyped]] (T a_hash, ?::Hash[untyped, untyped] opts) -> T

      # Returns a clone of a_hash updated with the authoriation header
      def apply: [T < ::Hash[untyped, untyped]] (T a_hash, ?::Hash[untyped, untyped] opts) -> T

      # Returns a reference to the #apply method, suitable for passing as
      # a closure
      def updater_proc: () -> ^(::Hash[untyped, untyped] a_hash, ?::Hash[untyped, untyped] opts) -> ::Hash[untyped, untyped]

      # Creates a jwt uri token.
      def new_jwt_token: (?String? jwt_aud_uri, ?::Hash[untyped, untyped] options) -> String

      # Duck-types the corresponding method from BaseClient
      def needs_access_token?: () -> false
    end
  end
end
