module ActiveStorage
  # = Active Storage Mirror \Service
  #
  # Wraps a set of mirror services and provides a single ActiveStorage::Service object that will all
  # have the files uploaded to them. A +primary+ service is designated to answer calls to:
  # * +download+
  # * +exist?+
  # * +url+
  # * +url_for_direct_upload+
  # * +headers_for_direct_upload+
  class Service::MirrorService < ::ActiveStorage::Service
    def download: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
    def download_chunk: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
    def exist?: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
    def url: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
    def url_for_direct_upload: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
    def headers_for_direct_upload: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
    def path_for: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
    def compose: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped

    attr_reader primary: untyped

    attr_reader mirrors: untyped

    # Stitch together from named services.
    def self.build: (primary: untyped, mirrors: untyped, name: untyped, configurator: untyped, **untyped options) -> untyped

    def initialize: (primary: untyped, mirrors: untyped) -> void

    # Upload the +io+ to the +key+ specified to all services. The upload to the primary service is done synchronously
    # whereas the upload to the mirrors is done asynchronously. If a +checksum+ is provided, all services will
    # ensure a match when the upload has completed or raise an ActiveStorage::IntegrityError.
    def upload: (untyped key, untyped io, ?checksum: untyped?, **untyped options) -> untyped

    # Delete the file at the +key+ on all services.
    def delete: (untyped key) -> untyped

    # Delete files at keys starting with the +prefix+ on all services.
    def delete_prefixed: (untyped prefix) -> untyped

    def mirror_later: (untyped key, checksum: untyped) -> untyped

    # Copy the file at the +key+ from the primary service to each of the mirrors where it doesn't already exist.
    def mirror: (untyped key, checksum: untyped) -> untyped

    private

    def each_service: () { (?) -> untyped } -> untyped

    def perform_across_services: (untyped method, *untyped args) -> untyped
  end
end

