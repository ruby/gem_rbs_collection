    def compose: (untyped source_keys, untyped destination_key, ?filename: untyped?, ?content_type: untyped?, ?disposition: untyped?, ?custom_metadata: ::Hash[untyped, untyped]) -> untyped

    private

    def upload_stream: (key: untyped, **untyped options) { (?) -> untyped } -> untyped

    def private_url: (untyped key, expires_in: untyped, filename: untyped, disposition: untyped, content_type: untyped, **untyped client_opts) -> untyped

    def public_url: (untyped key, **untyped client_opts) -> untyped

    MAXIMUM_UPLOAD_PARTS_COUNT: 10000

    MINIMUM_UPLOAD_PART_SIZE: untyped

    def upload_with_single_part: (untyped key, untyped io, ?checksum: untyped?, ?content_type: untyped?, ?content_disposition: untyped?, ?custom_metadata: ::Hash[untyped, untyped]) -> untyped

    def upload_with_multipart: (untyped key, untyped io, ?content_type: untyped?, ?content_disposition: untyped?, ?custom_metadata: ::Hash[untyped, untyped]) -> untyped

    def object_for: (untyped key) -> untyped

