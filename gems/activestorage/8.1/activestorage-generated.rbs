    # Reads the file for the given key in chunks, yielding each to the block.
    def stream: (untyped key) { (untyped) -> untyped } -> untyped

    def bucket: () -> untyped

    def client: () -> untyped

    def issuer: () -> untyped

    def email_from_metadata_server: () -> untyped

    def signer: () -> untyped

    def custom_metadata_headers: (untyped metadata) -> untyped
