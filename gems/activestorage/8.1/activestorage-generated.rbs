module ActiveStorage
  # = Active Storage \Disk \Service
  #
  # Wraps a local disk path as an Active Storage service. See ActiveStorage::Service for the generic API
  # documentation that applies to all services.
  class Service::DiskService < ::ActiveStorage::Service
    attr_accessor root: untyped

    def initialize: (root: untyped, ?public: bool, **untyped options) -> void

    def upload: (untyped key, untyped io, ?checksum: untyped?, **untyped) -> untyped

    def download: (untyped key) ?{ (?) -> untyped } -> untyped

    def download_chunk: (untyped key, untyped range) -> untyped

    def delete: (untyped key) -> untyped

    def delete_prefixed: (untyped prefix) -> untyped

    def exist?: (untyped key) -> untyped

    def url_for_direct_upload: (untyped key, expires_in: untyped, content_type: untyped, content_length: untyped, checksum: untyped, ?custom_metadata: ::Hash[untyped, untyped]) -> untyped

    def headers_for_direct_upload: (untyped key, content_type: untyped, **untyped) -> { "Content-Type" => untyped }

    # Every filesystem operation in DiskService resolves paths through this method (or through
    # make_path_for, which delegates here). This is the primary filesystem security check: all
    # path-traversal protection is enforced here. New methods that touch the filesystem MUST use
    # path_for or make_path_for -- never construct paths from +root+ directly.
    def path_for: (untyped key) -> untyped

    def compose: (untyped source_keys, untyped destination_key, **untyped) -> untyped

    private

    def private_url: (untyped key, expires_in: untyped, filename: untyped, content_type: untyped, disposition: untyped, **untyped) -> untyped

    def public_url: (untyped key, filename: untyped, ?content_type: untyped?, ?disposition: ::Symbol, **untyped) -> untyped

    def generate_url: (untyped key, expires_in: untyped, filename: untyped, content_type: untyped, disposition: untyped) -> untyped

    def stream: (untyped key) { (untyped) -> untyped } -> untyped

    def folder_for: (untyped key) -> untyped

    def escape_glob_metacharacters: (untyped path) -> untyped

    def make_path_for: (untyped key) -> untyped

    def ensure_integrity_of: (untyped key, untyped checksum) -> (untyped | nil)

    def url_helpers: () -> untyped

    def url_options: () -> untyped
  end
end

module ActiveStorage
  # = Active Storage \GCS \Service
  #
  # Wraps the Google Cloud Storage as an Active Storage service. See ActiveStorage::Service for the generic API
  # documentation that applies to all services.
  class Service::GCSService < ::ActiveStorage::Service
    class MetadataServerError < ::ActiveStorage::Error
    end

    class MetadataServerNotFoundError < ::ActiveStorage::Error
    end

    def initialize: (?public: bool, **untyped config) -> void

    def upload: (untyped key, untyped io, ?checksum: untyped?, ?content_type: untyped?, ?disposition: untyped?, ?filename: untyped?, ?custom_metadata: ::Hash[untyped, untyped]) -> untyped

    def download: (untyped key) ?{ (?) -> untyped } -> untyped

    def update_metadata: (untyped key, content_type: untyped, ?disposition: untyped?, ?filename: untyped?, ?custom_metadata: ::Hash[untyped, untyped]) -> untyped

    def download_chunk: (untyped key, untyped range) -> untyped

    def delete: (untyped key) -> untyped

    def delete_prefixed: (untyped prefix) -> untyped

    def exist?: (untyped key) -> untyped

    def url_for_direct_upload: (untyped key, expires_in: untyped, checksum: untyped, ?custom_metadata: ::Hash[untyped, untyped], **untyped) -> untyped

    def headers_for_direct_upload: (untyped key, checksum: untyped, ?filename: untyped?, ?disposition: untyped?, ?custom_metadata: ::Hash[untyped, untyped], **untyped) -> untyped

    def compose: (untyped source_keys, untyped destination_key, ?filename: untyped?, ?content_type: untyped?, ?disposition: untyped?, ?custom_metadata: ::Hash[untyped, untyped]) -> untyped

    # Returns the IAM client used for direct uploads and signed URLs.
    # By default, the authorization for the IAM client is set to
    # {Application Default Credentials}[https://docs.cloud.google.com/docs/authentication/application-default-credentials],
    # fetched once at instantiation time, then refreshed automatically when expired.
    # This can be set to a different value to use other authorization methods.
    #
    #   ActiveStorage::Blob.service.iam_client.authorization = Google::Auth::ImpersonatedServiceAccountCredentials.new(options)
    def iam_client: () -> untyped

    private

    def private_url: (untyped key, expires_in: untyped, filename: untyped, content_type: untyped, disposition: untyped, **untyped) -> untyped

    def public_url: (untyped key, **untyped) -> untyped

