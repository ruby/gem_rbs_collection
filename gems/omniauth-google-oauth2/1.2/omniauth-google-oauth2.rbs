module OmniAuth
  module GoogleOauth2
    VERSION: String
  end

  module Strategies
    class GoogleOauth2 < OmniAuth::Strategies::OAuth2
      ALLOWED_ISSUERS: Array[String]
      BASE_SCOPE_URL: String
      BASE_SCOPES: Array[String]
      DEFAULT_SCOPE: String
      USER_INFO_URL: String
      AUTHORIZE_OPTIONS: Array[Symbol]

      def authorize_params: () -> Hash[untyped, untyped]

      def raw_info: () -> Hash[String, untyped]
    end
  end
end
