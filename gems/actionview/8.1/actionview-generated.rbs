        def tag_id: (?untyped? index, ?untyped? namespace) -> untyped

        def sanitized_method_name: () -> untyped

        def sanitized_value: (untyped value) -> untyped

        def name_and_id_index: (untyped options) -> untyped

        def generate_ids?: () -> untyped
      end
    end
  end
