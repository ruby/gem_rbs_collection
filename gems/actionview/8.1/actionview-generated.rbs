        def render_collection: () { (untyped, untyped, untyped, untyped) -> untyped } -> untyped

        def render_collection_for: (untyped builder_class) ?{ (?) -> untyped } -> untyped

        def hidden_field: () -> untyped

        def hidden_field_name: () -> ::String
      end
    end
