      def dependencies: () -> untyped

      def self.supports_view_paths?: () -> true

      def initialize: (untyped name, untyped template, ?untyped? view_paths, ?parser_class: untyped) -> void

      private

      attr_reader template: untyped

      attr_reader name: untyped

