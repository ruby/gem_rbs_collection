# faraday_middleware 1.x works with Faraday 1.x.
#
# Middleware is usually registered by name:
#
#   Faraday.new do |conn|
#     conn.request :oauth2, 'TOKEN', token_type: 'bearer'
#     conn.response :xml, content_type: /\bxml$/
#     conn.use FaradayMiddleware::FollowRedirects, limit: 5
#   end
#
# Classes whose optional library is missing still load; `new` then raises
# (Faraday's dependency loader): ParseXml needs multi_xml, ParseYaml needs
# safe_yaml, Mashify needs hashie, Rashify needs rash_alt, OAuth needs
# simple_oauth and Instrumentation needs activesupport.
module FaradayMiddleware
  # Defined by `require "faraday_middleware/version"`.
  VERSION: String

  # The base class for middleware that parses response bodies.
  class ResponseMiddleware < Faraday::Middleware
    # Anything that turns a response body into the parsed result.
    interface _Parser
      def call: (untyped body, untyped parser_options) -> untyped
    end

    CONTENT_TYPE: String

    type parser = _Parser | ^(untyped body, untyped parser_options) -> untyped

    attr_accessor self.parser: parser?

    # Raises ArgumentError when given neither a parser nor a block.
    def self.define_parser: (parser parser) -> parser
                          | () { (untyped body, untyped parser_options) -> untyped } -> ^(untyped body, untyped parser_options) -> untyped

    def initialize: (?untyped app, ?content_type: String | Regexp | Array[String | Regexp], ?parser_options: untyped, ?preserve_raw: boolish) -> void
                  | (?untyped app, ?Hash[Symbol, untyped] options) -> void

    def call: (Faraday::Env environment) -> Faraday::Response

    # Raises Faraday::ParsingError when the parser fails.
    def process_response: (Faraday::Env env) -> untyped

    # Raises Faraday::ParsingError when the parser fails.
    def parse: (untyped body) -> untyped

    def response_type: (Faraday::Env env) -> String

    def process_response_type?: (String type) -> bool

    def parse_response?: (Faraday::Env env) -> bool

    def preserve_raw?: (Faraday::Env env) -> boolish
  end

  # Adds the `preserve_raw` option to Faraday::RequestOptions.
  module OptionsExtension
    attr_accessor preserve_raw: boolish
  end

  class EncodeJson < Faraday::Middleware
    CONTENT_TYPE: String
    MIME_TYPE: String
    MIME_TYPE_REGEX: Regexp

    def call: (Faraday::Env env) -> untyped

    def encode: (untyped data) -> String
  end

  class MethodOverride < Faraday::Middleware
    HEADER: String

    # `rewrite` is required when options are given (KeyError otherwise).
    def initialize: (untyped app, ?nil options) -> void
                  | (untyped app, rewrite: Array[String | Symbol]?) -> void
                  | (untyped app, { rewrite: Array[String | Symbol]? } options) -> void

    def call: (Faraday::Env env) -> untyped
  end

  class OAuth < Faraday::Middleware
    AUTH_HEADER: String
    CONTENT_TYPE: String
    TYPE_URLENCODED: String

    # The options are passed to SimpleOAuth::Header: :consumer_key,
    # :consumer_secret, :token, :token_secret, ...
    def initialize: (untyped app, Hash[Symbol, untyped] options) -> void

    def call: (Faraday::Env env) -> untyped
  end

  class OAuth2 < Faraday::Middleware
    PARAM_NAME: String
    TOKEN_TYPE: String
    AUTH_HEADER: String

    attr_reader param_name: String
    attr_reader token_type: String

    # Raises ArgumentError for an empty :param_name with token_type "param".
    def initialize: (untyped app, ?_ToS? token, ?param_name: _ToS, ?token_type: _ToS) -> void
                  | (untyped app, ?_ToS? token, ?Hash[Symbol, untyped] options) -> void

    def call: (Faraday::Env env) -> untyped
  end

  class Mashify < Faraday::Response::Middleware
    attr_accessor self.mash_class: Class?

    attr_accessor mash_class: Class?

    def initialize: (?untyped app, ?mash_class: Class) -> void
                  | (?untyped app, ?Hash[Symbol, untyped] options) -> void

    def parse: (untyped body) -> untyped
  end

  class Rashify < Mashify
  end

  class ParseJson < ResponseMiddleware
    class MimeTypeFix < ResponseMiddleware
      MIME_TYPE: String
      BRACKETS: Array[String]
      WHITESPACE: Array[String]

      def process_response: (Faraday::Env env) -> String

      def parse_response?: (Faraday::Env env) -> bool

      def first_char: (String body) -> String?
    end
  end

  class ParseXml < ResponseMiddleware
  end

  class ParseMarshal < ResponseMiddleware
  end

  class ParseYaml < ResponseMiddleware
  end

  class ParseDates < Faraday::Response::Middleware
    ISO_DATE_FORMAT: Regexp

    def initialize: (untyped app, ?match: Regexp) -> void
                  | (untyped app, ?Hash[Symbol, untyped] options) -> void

    def call: (Faraday::Env env) -> Faraday::Response
  end

  class Caching < Faraday::Middleware
    interface _Cache
      def read: (String key) -> Faraday::Response?
      def write: (String key, Faraday::Response response, ?untyped options) -> untyped
    end

    CACHEABLE_STATUS_CODES: Array[Integer]

    attr_reader cache: _Cache

    def initialize: (untyped app, _Cache cache, ?ignore_params: _ToS | Array[_ToS], ?write_options: untyped, ?full_key: boolish, ?status_codes: _ToI | Array[_ToI]) -> void
                  | (untyped app, _Cache cache, ?Hash[Symbol, untyped] options) -> void
                  | (untyped app, ?ignore_params: _ToS | Array[_ToS], ?write_options: untyped, ?full_key: boolish, ?status_codes: _ToI | Array[_ToI]) { () -> _Cache } -> void
                  | (untyped app, Hash[Symbol, untyped] options) { () -> _Cache } -> void
                  | (untyped app, ?nil cache, ?Hash[Symbol, untyped] options) { () -> _Cache } -> void

    def call: (Faraday::Env env) -> untyped
  end

  class Chunked < ResponseMiddleware
    TRANSFER_ENCODING: String

    def parse_response?: (Faraday::Env env) -> bool?

    def chunked_encoding?: (Hash[untyped, untyped] headers) -> bool?
  end

  class RackCompatible
    NON_PREFIXED_HEADERS: Array[String]

    # rack_handler.new(app, *args) builds the Rack middleware.
    def initialize: (untyped app, untyped rack_handler, *untyped args) -> void

    def call: (Faraday::Env env) -> Faraday::Response
  end

  class RedirectLimitReached < Faraday::ClientError
    def response: () -> Faraday::Response

    def initialize: (Faraday::Response response) -> void
  end

  class FollowRedirects < Faraday::Middleware
    interface _Callback
      def call: (Faraday::Env old_env, Faraday::Env new_env) -> untyped
    end

    ALLOWED_METHODS: Set[Symbol]
    REDIRECT_CODES: Set[Integer]
    ENV_TO_CLEAR: Set[Symbol]
    FOLLOW_LIMIT: Integer
    URI_UNSAFE: Regexp
    AUTH_HEADER: String

    def initialize: (untyped app, ?limit: Integer, ?standards_compliant: boolish, ?callback: _Callback | ^(Faraday::Env old_env, Faraday::Env new_env) -> untyped, ?clear_authorization_header: boolish) -> void
                  | (untyped app, ?Hash[Symbol, untyped] options) -> void

    # Raises RedirectLimitReached after more than `limit` redirects.
    def call: (Faraday::Env env) -> Faraday::Response
  end

  class Instrumentation < Faraday::Middleware
    def initialize: (untyped app, ?name: String) -> void
                  | (untyped app, ?Hash[Symbol, untyped] options) -> void

    def call: (Faraday::Env env) -> untyped
  end

  class Gzip < Faraday::Middleware
    def self.optional_dependency: (String lib) -> bool
                                | () { () -> untyped } -> bool

    BROTLI_SUPPORTED: bool

    def self.supported_encodings: () -> Array[String]

    ACCEPT_ENCODING: String
    CONTENT_ENCODING: String
    CONTENT_LENGTH: String
    SUPPORTED_ENCODINGS: String

    def call: (Faraday::Env env) -> Faraday::Response
  end
end

module Faraday
  class RequestOptions
    include FaradayMiddleware::OptionsExtension
  end

  class Response
    # Faraday 1.x only; gems/faraday types Faraday 2.x, which removed it.
    class Middleware < Faraday::Middleware
    end

    # Deprecated aliases
    class Mashify = FaradayMiddleware::Mashify
    class Rashify = FaradayMiddleware::Rashify
    class ParseJson = FaradayMiddleware::ParseJson
    class ParseXml = FaradayMiddleware::ParseXml
    class ParseMarshal = FaradayMiddleware::ParseMarshal
    class ParseYaml = FaradayMiddleware::ParseYaml
  end

  class Request
    # Deprecated aliases
    class OAuth = FaradayMiddleware::OAuth
    class OAuth2 = FaradayMiddleware::OAuth2
  end
end
